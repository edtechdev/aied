---
// "Use this knowledge base with your own AI assistant", rendered for any locale
// from src/i18n/pages/ai.<locale>.ts (the copyable prompt included).
import BaseLayout from '../../layouts/BaseLayout.astro';
import TranslationNotice from '../TranslationNotice.astro';
import { strings } from '../../i18n';
import { localizeHtml } from '../../i18n/config';

const { locale } = Astro.props;
const s = strings(locale).ai;
const ui = strings(locale).ui;
const L = (html: string) => localizeHtml(html, locale);
const copyLabels = { ok: s.copyOk, fail: s.copyFail };
---

<BaseLayout title={s.title} description={s.description} locale={locale} toc={s.toc}>
  <TranslationNotice locale={locale} html={ui.translationNoticeHtml} />
  <h1>{s.h1}</h1>

  <p style="line-height:1.7" set:html={L(s.introHtml)} />
  <p style="line-height:1.7" set:html={L(s.intro2Html)} />

  <h2 id="the-prompt">{s.promptHeading}</h2>
  <p style="line-height:1.7">{s.promptIntro}</p>
  <p class="prompt-actions">
    <button id="copy-prompt-btn" type="button" class="copy-btn">{s.copyButton}</button>
    <span class="prompt-hint">{s.copyHint}</span>
  </p>
  <pre id="prompt-block" tabindex="0" aria-label={s.promptAriaLabel}><code>{s.promptText}</code></pre>

  <h2 id="how-to-use-it">{s.howHeading}</h2>
  <ol style="line-height:1.9">
    {s.howSteps.map((step) => <li set:html={step} />)}
  </ol>
  <p style="line-height:1.7" set:html={L(s.howNoteHtml)} />
  <details style="line-height:1.8;margin-top:0.5rem">
    <summary style="cursor:pointer;font-weight:600">{s.techSummary}</summary>
    <ul style="line-height:1.9;margin-top:0.5rem">
      {s.techItems.map((item) => <li set:html={item} />)}
    </ul>
  </details>

  <h2 id="ready-made-assistants">{s.assistantsHeading}</h2>
  <p style="line-height:1.7">{s.assistantsIntro}</p>
  <ul style="line-height:1.9">
    {s.assistants.map((item) => <li set:html={item} />)}
  </ul>

  <h2 id="what-is-in-the-knowledge-base">{s.corpusHeading}</h2>
  <p style="line-height:1.7">{s.corpusHtml1}</p>
  <p style="line-height:1.7" set:html={s.corpusHtml2} />

  <h2 id="already-answered">{s.answeredHeading}</h2>
  <p style="line-height:1.7">{s.answeredIntro}</p>
  <ul style="line-height:1.9">
    {s.answeredLinks.map((l) => (
      <li><a href={l.href}>{l.label}</a></li>
    ))}
  </ul>
  <p style="line-height:1.7" set:html={L(s.answeredOutroHtml)} />

  <h2 id="read-offline">{s.offlineHeading}</h2>
  <p style="line-height:1.7" set:html={L(s.offlineHtml)} />
</BaseLayout>

<style>
  .prompt-actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-bottom: 0.6rem;
  }
  .copy-btn {
    padding: 0.5rem 1rem;
    background: #2f6f4f;
    color: #fff;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .copy-btn:hover {
    background: #27603f;
  }
  .prompt-hint {
    font-size: 0.85rem;
    opacity: 0.75;
  }
  /* Keep the prompt in a scrollable box so it does not dominate the page. */
  #prompt-block {
    max-height: 20rem;
    overflow-y: auto;
    overflow-x: auto;
    background: #f6f6f7;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 1rem;
    font-size: 0.85rem;
    line-height: 1.55;
    white-space: pre-wrap;
    margin: 0;
  }
  #prompt-block:focus-visible {
    outline: 2px solid #2f6f4f;
    outline-offset: 2px;
  }
  @media (max-width: 600px) {
    #prompt-block {
      max-height: 16rem;
    }
    .prompt-hint {
      display: none;
    }
  }
</style>

<script define:vars={{ copyLabels }}>
  // Plain JS on purpose: `define:vars` makes Astro emit this script inline
  // (unprocessed), so TypeScript syntax is not available here.
  const btn = document.getElementById('copy-prompt-btn');
  const pre = document.getElementById('prompt-block');
  if (btn && pre) {
    btn.addEventListener('click', async () => {
      const text = pre.innerText;
      let ok = false;
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
          ok = true;
        }
      } catch (e) { /* fall through to legacy path */ }
      if (!ok) {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { ok = document.execCommand('copy'); } catch (e) { /* ignore */ }
        document.body.removeChild(ta);
      }
      const orig = btn.textContent;
      btn.textContent = ok ? copyLabels.ok : copyLabels.fail;
      btn.disabled = true;
      setTimeout(() => { btn.textContent = orig; btn.disabled = false; }, 2000);
    });
  }
</script>