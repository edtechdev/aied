---
// A translated content page (FAQ, concept or resource) rendered from a locale
// folder: fr/faqs/x.md, es/concepts/y.md, zh/resources/z.md. It mirrors the English
// page's chrome so a translation looks like the page it translates, and adds a note
// that the surrounding knowledge base is in English.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TranslationNotice from '../TranslationNotice.astro';
import ConnectedList from '../ConnectedList.astro';
import MetadataTable from '../MetadataTable.astro';
import SourceButtons from '../SourceButtons.astro';
import { renderMarkdown } from '../../lib/markdown';
import { strings } from '../../i18n';

const { entry, locale, pageType } = Astro.props;
const s = strings(locale).ui;
const chrome = s.chrome;
const data = entry.data;
const slug = entry.id.split('/').pop().replace(/\.md$/, '');
const translationOf = data.translation_of || `${pageType}/${slug}`;
const englishPath = `/aied/${translationOf}/`;

const concepts = await getCollection('concepts');
const articles = await getCollection('articles');
const faqs = await getCollection('faqs');
const resources = await getCollection('resources');
const titles: Record<string, string> = {};
[...concepts, ...articles, ...faqs].forEach((c) => {
  titles[c.id.replace(/\.md$/, '')] = c.data.title;
});
const conceptTitles: Record<string, string> = Object.fromEntries(
  concepts.map((c) => [c.id.replace(/\.md$/, ''), c.data.title]),
);
const rendered = renderMarkdown(entry.body || '', {
  pageTitle: data.title,
  articleSlugs: new Set(articles.map((a) => a.id.replace(/\.md$/, ''))),
  conceptSlugs: new Set(concepts.map((c) => c.id.replace(/\.md$/, ''))),
  faqSlugs: new Set(faqs.map((f) => f.id.replace(/\.md$/, ''))),
  titles,
});
// Connected FAQs and Connected resources come from frontmatter, exactly as they do on
// the English page, so a translation carries the same sections and TOC entries.
const byId = new Map(
  [...faqs, ...resources].map((c) => [c.id.replace(/\.md$/, ''), c] as const),
);
const connectedFaqs = (data.connected_faqs || [])
  .map((id: string) => byId.get(id.replace(/\.md$/, '')))
  .filter(Boolean);
const connectedResources = (data.connected_resources || [])
  .map((id: string) => byId.get(id.replace(/\.md$/, '')))
  .filter(Boolean);

const toc = rendered.headings.filter((h) => h.depth <= 3);
if (connectedFaqs.length > 0) toc.push({ text: chrome.metadataLabels.connected_faqs, slug: 'connected-faqs', depth: 2 });
if (connectedResources.length > 0) toc.push({ text: chrome.metadataLabels.connected_resources, slug: 'connected-resources', depth: 2 });
const kindLabels: Record<string, string> = { concepts: chrome.concepts, resources: chrome.resources, faqs: chrome.faqs };
const badge = kindLabels[pageType as string] ?? pageType;
const createdDisplay = (data.created || '').split('T')[0];
const updatedDisplay = (data.updated || data.created || '').split('T')[0];
---

<BaseLayout title={data.title} locale={locale} toc={toc} route={`/${translationOf}`}>
  <TranslationNotice
    locale={locale}
    html={`${s.translationNoticeHtml} <a href="${englishPath}">${s.originalPageLabel}</a>`}
  />
  <article data-pagefind-filter={`page_type:${pageType.replace(/s$/, '')}`}>
    <div class="page-header" id="top">
      <p class="page-type-badge">{badge}</p>
      <h1>{data.title}</h1>
      <div class="page-meta">
        {chrome.metadataLabels.created} {createdDisplay}{data.updated ? ` · ${chrome.metadataLabels.updated} ${updatedDisplay}` : ''}
      </div>
      {pageType === 'resources' && data.url && (
        <p class="resource-line">
          <a href={data.url}>{data.url.replace(/^https?:\/\//, '')}</a>
          {data.author ? ` · ${data.author}` : ''}
          {data.access ? ` · ${(data.access || []).join(', ')}` : ''}
          {data.last_verified ? ` · ${chrome.lastVerified} ${data.last_verified}` : ''}
        </p>
      )}
    </div>

    <div style="line-height:1.8" data-pagefind-body>
      <Fragment set:html={rendered.html} />
    </div>

    <ConnectedList
      id="connected-faqs"
      heading={chrome.metadataLabels.connected_faqs}
      items={connectedFaqs.map((f: any) => ({
        href: `/aied/faqs/${f.id.replace('.md', '')}/`,
        title: f.data.title,
        kind: 'faq' as const,
      }))}
    />

    <ConnectedList
      id="connected-resources"
      heading={chrome.metadataLabels.connected_resources}
      items={connectedResources.map((r: any) => ({
        href: `/aied/resources/${r.id.replace('.md', '')}/`,
        title: r.data.title,
        kind: 'resource' as const,
        summary: r.data.summary,
      }))}
    />

    <MetadataTable conceptTitles={conceptTitles} data={data} locale={locale} />
    <SourceButtons filePath={`${locale}/${translationOf}.md`} locale={locale} />
  </article>
</BaseLayout>

<style>
  .page-type-badge {
    font-size: 0.8rem;
    color: var(--muted-color);
    margin-bottom: 0.25rem;
    letter-spacing: 0.04em;
  }
  .page-meta {
    color: var(--muted-color);
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }
  .resource-line {
    font-size: 0.9rem;
    color: var(--muted-color);
    margin: 0 0 0.75rem 0;
    word-break: break-word;
  }
</style>