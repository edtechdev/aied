---
// Search page, rendered for any locale from src/i18n/pages/search.<locale>.ts.
// The pagefind index itself is global (built from every page), so a localized
// search page searches the same corpus; only the chrome is translated here.
// The interface itself lives in SearchInterface.astro, which the 404 page also
// renders so the two cannot drift apart.
import BaseLayout from '../../layouts/BaseLayout.astro';
import KnowledgeBaseStats from '../KnowledgeBaseStats.astro';
import SearchInterface from '../SearchInterface.astro';
import TranslationNotice from '../TranslationNotice.astro';
import { strings } from '../../i18n';

const { locale } = Astro.props;
const s = strings(locale).search;
const ui = strings(locale).ui;
---

<BaseLayout title={s.title} locale={locale} hideHeaderSearch>
  <TranslationNotice locale={locale} html={ui.translationNoticeHtml} />
  <h1><svg class="page-type-icon" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>{s.h1}</h1>
  <p style="color:var(--muted-color);margin-bottom:1rem;">
    {s.intro}
  </p>

  <div class="search-corpus">
    <p style="color:var(--muted-color);margin-bottom:0.5rem;">
      {s.corpusIntro}
    </p>
    <KnowledgeBaseStats locale={locale} />
  </div>

  <SearchInterface locale={locale} />
</BaseLayout>

<style>
  .search-corpus {
    max-width: 800px;
    margin: 0 auto 1.25rem auto;
  }
</style>