---
// Language switcher: a globe icon in the header that opens a small popover with
// one entry per locale, adapted to this site's layout.
// Each entry links to the same page in that language where a translation exists,
// and to that language's home page where it does not, marked "English only".
import { LOCALES, switcherEntries, localeLabel } from '../i18n/config';
import { strings } from '../i18n';

const { locale = 'en', route = '/', translationMap, align = 'right' } = Astro.props;
const ui = strings(locale).ui;
const entries = switcherEntries(route, locale, translationMap);
const current = LOCALES.find((l) => l.code === locale) || LOCALES[0];
---

<div class={`lang-switcher align-${align}`} data-lang-switcher>
  <button
    type="button"
    class="lang-toggle"
    data-lang-toggle
    aria-haspopup="true"
    aria-expanded="false"
    aria-label={`${ui.language}: ${localeLabel(locale)}`}
    title={`${ui.language}: ${localeLabel(locale)}`}
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    <span class="lang-code">{current.code.toUpperCase()}</span>
  </button>

  <div class="lang-menu" data-lang-menu hidden role="menu" aria-label={ui.chooseLanguage}>
    <p class="lang-menu-title">{ui.chooseLanguage}</p>
    <ul>
      {entries.map((e) => (
        <li>
          <a
            href={e.href}
            role="menuitem"
            class:list={['lang-item', { current: e.current, untranslated: !e.translated }]}
            aria-current={e.current ? 'true' : undefined}
            title={!e.translated ? ui.notTranslatedHint : undefined}
            hreflang={e.code}
          >
            <span class="lang-label">{e.label}</span>
            {!e.translated && <span class="lang-flag">{ui.notTranslated}</span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .lang-switcher {
    position: relative;
    display: inline-flex;
  }
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.5rem;
    border: 1px solid transparent;
    border-radius: 6px;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .lang-toggle:hover,
  .lang-toggle:focus-visible {
    border-color: var(--card-border-color);
    background: color-mix(in srgb, var(--primary) 8%, transparent);
  }
  .lang-code {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .lang-menu {
    position: absolute;
    top: calc(100% + 0.35rem);
    right: 0;
    z-index: 60;
    min-width: 13rem;
    padding: 0.5rem;
    border: 1px solid var(--card-border-color);
    border-radius: 8px;
    background: var(--card-background-color);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
  }
  .lang-menu[hidden] {
    display: none;
  }
  /* In a narrow column (right sidebar, mobile content column) the menu opens
     left-aligned so it cannot spill off the side of the page. */
  .lang-switcher.align-left .lang-menu {
    left: 0;
    right: auto;
  }
  .lang-switcher.align-left .lang-toggle {
    width: 100%;
    justify-content: flex-start;
    border-color: var(--card-border-color);
    background: var(--card-background-color);
  }
  .lang-menu-title {
    margin: 0.15rem 0.4rem 0.4rem 0.4rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted-color);
  }
  .lang-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .lang-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.4rem 0.5rem;
    border-radius: 6px;
    color: var(--color);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .lang-item:hover,
  .lang-item:focus-visible {
    background: color-mix(in srgb, var(--primary) 10%, transparent);
  }
  .lang-item.current {
    font-weight: 700;
  }
  .lang-flag {
    font-size: 0.7rem;
    color: var(--muted-color);
    border: 1px solid var(--card-border-color);
    border-radius: 4px;
    padding: 0.05rem 0.3rem;
    white-space: nowrap;
  }
</style>

<script>
  // One delegated handler per switcher: open/close on the button, close on an
  // outside click, on Escape, or when a language is chosen.
  document.querySelectorAll('[data-lang-switcher]').forEach((root) => {
    const btn = root.querySelector('[data-lang-toggle]') as HTMLButtonElement | null;
    const menu = root.querySelector('[data-lang-menu]') as HTMLElement | null;
    if (!btn || !menu) return;
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
    };
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(menu.hidden);
    });
    document.addEventListener('click', (e) => {
      if (!menu.hidden && !root.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        btn.focus();
      }
    });
  });
</script>