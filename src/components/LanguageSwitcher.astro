---
// Language switcher: a globe icon in the header that opens a small popover with
// one entry per locale, adapted to this site's layout.
// Each entry links to the same page in that language where a translation exists,
// and to that language's home page where it does not, marked "English only".
import { LOCALES, switcherEntries, localeLabel } from '../i18n/config';
import { strings } from '../i18n';

const {
  locale = 'en',
  route = '/',
  translationMap,
  align = 'right',
  variant = 'button',
  labelStyle = 'code',
} = Astro.props;
const ui = strings(locale).ui;
const entries = switcherEntries(route, locale, translationMap);
const current = LOCALES.find((l) => l.code === locale) || LOCALES[0];
---

<div class={`lang-switcher align-${align}`} data-lang-switcher data-variant={variant}>
  {variant === 'button' && (
  <button
    type="button"
    class="lang-toggle"
    data-lang-toggle
    aria-haspopup="true"
    aria-expanded="false"
    aria-label={`${ui.language}: ${localeLabel(locale)}`}
    title={`${ui.language}: ${localeLabel(locale)}`}
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    {labelStyle !== 'none' && (
      <span class="lang-code">{labelStyle === 'name' ? current.label : current.code.toUpperCase()}</span>
    )}
  </button>
  )}

  {variant === 'button' ? (
  <div class="lang-menu" data-lang-menu hidden role="menu" aria-label={ui.chooseLanguage}>
    <p class="lang-menu-title">{ui.chooseLanguage}</p>
    <ul>
      {entries.map((e) => (
        <li>
          <a
            href={e.href}
            data-locale-code={e.code}
            role="menuitem"
            class:list={['lang-item', { current: e.current, untranslated: !e.translated }]}
            aria-current={e.current ? 'true' : undefined}
            title={!e.translated ? ui.notTranslatedHint : undefined}
            hreflang={e.code}
          >
            <span class="lang-label">{e.label}</span>
            {!e.translated && <span class="lang-flag">{ui.notTranslated}</span>}
          </a>
        </li>
      ))}
    </ul>
    </div>
  ) : (
    <div class="lang-inline" role="menu" aria-label={ui.chooseLanguage}>
      <p class="lang-menu-title">{ui.chooseLanguage}</p>
      <ul>
        {entries.map((e) => (
          <li>
            <a
              href={e.href}
              role="menuitem"
              class:list={['lang-item', { current: e.current, untranslated: !e.translated }]}
              aria-current={e.current ? 'true' : undefined}
              title={!e.translated ? ui.notTranslatedHint : undefined}
              hreflang={e.code}
            >
              <span class="lang-label">{e.label}</span>
              {!e.translated && <span class="lang-flag">{ui.notTranslated}</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</div>

<style>
  .lang-switcher {
    position: relative;
    display: inline-flex;
  }
  /* Same box and glyph as the header row's icon buttons, which is what keeps the
     globe the same size and on the same baseline as the icons beside it. */
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    min-width: 2.6rem;
    height: 2.6rem;
    margin: 0;
    padding: 0 0.35rem;
    color: var(--muted-color);
    border: 1px solid var(--muted-border-color);
    border-radius: 8px;
    background: transparent;
    line-height: 1;
    box-shadow: none;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .lang-toggle:hover,
  .lang-toggle:focus-visible {
    color: var(--primary);
    border-color: var(--primary);
    background: color-mix(in srgb, var(--primary) 10%, transparent);
    outline: none;
  }
  .lang-toggle svg {
    flex: 0 0 auto;
  }
  .lang-code {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .lang-menu {
    position: absolute;
    top: calc(100% + 0.35rem);
    inset-inline-end: 0;
    z-index: 60;
    min-width: 13rem;
    max-width: calc(100vw - 1.5rem);
    max-height: min(70dvh, 30rem);
    overflow-y: auto;
    /* A row wider than its popover must wrap inside it, never escape it. */
    overflow-x: hidden;
    padding: 0.5rem;
    border: 1px solid var(--card-border-color);
    border-radius: 8px;
    background: var(--card-background-color);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
  }
  .lang-menu[hidden] {
    display: none;
  }
  /* In a narrow column (right sidebar, mobile content column) the menu opens
     left-aligned so it cannot spill off the side of the page. */
  .lang-switcher.align-left .lang-menu {
    inset-inline-start: 0;
    inset-inline-end: auto;
  }
  .lang-switcher.align-left .lang-toggle {
    width: 100%;
    justify-content: flex-start;
    border-color: var(--card-border-color);
    background: var(--card-background-color);
  }
  /* Phone: stay anchored to the trigger. The base rule above already clamps the
     width to the viewport and scrolls a long list, so a narrow screen needs no
     sheet detached from the button that opened it: a list pinned to the bottom of
     the screen is not where a reader who just tapped the globe is looking. */
  @media (max-width: 640px) {
    .lang-menu {
      max-width: min(18rem, calc(100vw - 1.5rem));
      max-height: min(60dvh, 24rem);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
    }
  }
  .lang-menu-title {
    margin: 0.15rem 0.4rem 0.4rem 0.4rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted-color);
  }
  /* The language list is inside the header's <nav>, where the base stylesheet lays
     nav lists out horizontally: the locales then ran off the right edge however many
     there were. Stack them explicitly, one per row, and let each row fill the
     popover. */
  .lang-menu ul,
  .lang-inline ul {
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .lang-menu li,
  .lang-inline li {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
  }
  .lang-menu li::marker {
    content: '';
  }
  .lang-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    min-width: 0;
    padding: 0.4rem 0.5rem;
    border-radius: 6px;
    color: var(--color);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .lang-item:hover,
  .lang-item:focus-visible {
    background: color-mix(in srgb, var(--primary) 10%, transparent);
  }
  .lang-item.current {
    font-weight: 700;
  }
  .lang-label {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .lang-flag {
    flex: 0 0 auto;
    font-size: 0.7rem;
    color: var(--muted-color);
    border: 1px solid var(--card-border-color);
    border-radius: 4px;
    padding: 0.05rem 0.3rem;
    white-space: nowrap;
  }
</style>

<script>
  // One delegated handler per switcher: open/close on the button, close on an
  // outside click, on Escape, or when a language is chosen.
  // Remember the reader's choice: the default-locale home page reads this back and
  // offers that language instead of the English one.
  document.querySelectorAll('[data-lang-code]').forEach((link) => {
    link.addEventListener('click', () => {
      const code = (link as HTMLElement).dataset.localeCode;
      if (!code) return;
      try {
        localStorage.setItem('aied-locale', code);
      } catch {
        /* private mode: the choice simply does not persist */
      }
    });
  });

  document.querySelectorAll('[data-lang-switcher]').forEach((root) => {
    const btn = root.querySelector('[data-lang-toggle]') as HTMLButtonElement | null;
    const menu = root.querySelector('[data-lang-menu]') as HTMLElement | null;
    if (!btn || !menu) return;
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
    };
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(menu.hidden);
    });
    document.addEventListener('click', (e) => {
      if (!menu.hidden && !root.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        btn.focus();
      }
    });
  });
</script>