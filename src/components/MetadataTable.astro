---
// The typed metadata a page carries, rendered as a table at the foot of the page.
//
// This is the exhaustive, categorical view: every field the page holds, grouped by
// field. It is deliberately NOT a replacement for the curated Connected Concepts
// list, which says what a page relates to beyond what it is about. Values link to
// their concept page whenever one exists - facet values ARE concept slugs, and the
// phrase-valued fields (discipline, level, study design, intended audience) resolve
// through a generated value-to-slug map. Everything else renders as plain text.
//
// The field NAME links to the concept page that reads as the umbrella for the whole
// field - 'Study design' and 'Research methods' to the research methods page - so a
// reader can find out what a field means, not only which values a page carries. Generated map: FIELD_UMBRELLAS.
//
// On a phone the two-column table has nowhere to go, so below 640px - the site's
// main breakpoint - each row becomes a stacked block: the field name on its own
// line, its values underneath.
import { strings } from '../i18n';
import { METADATA_LINKS, FIELD_UMBRELLAS } from '../data/metadataLinks';
import { FACET_VOCAB, FACET_FIELDS, FACET_DISPLAY_ORDER } from '../data/facetVocab';

interface Props {
  // slug -> concept page title, for readable labels
  conceptTitles: Record<string, string>;
  // the page's frontmatter
  data: Record<string, any>;
  /** Locale whose chrome strings this component renders. */
  locale?: string;
}

const { conceptTitles, data, locale = 'en' } = Astro.props;
const chrome = strings(locale).ui.chrome;
const L = (key: string, fallback: string) => chrome.metadataLabels[key] || fallback;

// Page-level fields first: they describe the page itself (how it was studied, who
// it is for). Then the topic facets, in the one shared display order, read from the
// generated labels so a facet can never be called something the sidebar does not.
const PAGE_ROWS: { key: string; label: string }[] = [
  { key: 'research_method', label: L('research_method', 'Study design') },
  { key: 'discipline', label: L('discipline', 'Discipline') },
  { key: 'level', label: L('level', 'Level') },
  { key: 'audience', label: L('audience', 'Intended audience') },
];
const FACET_LABELS_MAP: Record<string, string> = Object.fromEntries(
  FACET_FIELDS.map((f) => [f.field as string, f.label as string]),
);
const ROWS: { key: string; label: string }[] = [
  ...PAGE_ROWS,
  ...(FACET_DISPLAY_ORDER as readonly string[]).map((field) => ({
    key: field,
    label: FACET_LABELS_MAP[field] || field,
  })),
  { key: 'page_kind', label: L('page_kind', 'Page kind') },
  // Resource pages carry fields no other page type has. They are absent elsewhere,
  // and `rows` filters empty rows out, so adding them here is safe for every page.
  { key: 'resource_type', label: L('resource_type', 'Type of resource') },
  { key: 'access', label: L('access', 'Access') },
  { key: 'license', label: L('license', 'License') },
];

const titleCase = (s: string) =>
  s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

const rows = ROWS.map((row) => {
  const values: string[] = Array.isArray(data[row.key]) ? data[row.key] : [];
  const isFacet = row.key in FACET_VOCAB;
  const items = values
    .filter((v) => typeof v === 'string' && v.trim() !== '')
    .map((value) => {
      const slug = isFacet
        ? value
        : (METADATA_LINKS[row.key] && METADATA_LINKS[row.key][value]) || null;
      // A facet value IS a concept slug, so its page title is the better label. A
      // phrase-valued field keeps its own wording - 'Music Education' must not be
      // relabelled 'Arts, Design and Media Education' just because that page is its
      // umbrella - and the link simply goes to the concept page that covers it.
      const text = isFacet
        ? (slug ? (conceptTitles[slug] || titleCase(value)) : titleCase(value))
        : titleCase(value);
      return { text, slug };
    });
  const umbrella = FIELD_UMBRELLAS[row.key];
  return {
    label: row.label,
    items,
    // only link a field name to a page that actually exists in this build
    umbrella: umbrella && conceptTitles[umbrella] ? umbrella : null,
  };
}).filter((row) => row.items.length > 0);
---
---

{rows.length > 0 && (
  <section id="metadata" class="metadata-section">
    <h2>{chrome.metadata}</h2>
    <table class="metadata-table">
      <tbody>
        {rows.map((row) => (
          <tr>
            <th scope="row" class="metadata-label">
              {row.umbrella ? (
                <a href={`/aied/concepts/${row.umbrella}/`} title={`What "${row.label}" covers`}>
                  {row.label}
                </a>
              ) : (
                row.label
              )}
            </th>
            <td class="metadata-values">
              {row.items.map((item, i) => (
                <>
                  {i > 0 ? ', ' : ''}
                  {item.slug ? <a href={`/aied/concepts/${item.slug}/`}>{item.text}</a> : item.text}
                </>
              ))}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
)}

<style>
  .metadata-section { margin-top: 2.5rem; }
  .metadata-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 0.75rem;
    font-size: 0.95rem;
  }
  .metadata-table th,
  .metadata-table td {
    padding: 0.45rem 0.75rem 0.45rem 0;
    vertical-align: top;
  }
  .metadata-table th {
    text-align: left;
    font-weight: 600;
    color: var(--muted-color);
    white-space: nowrap;
  }
  .metadata-values { overflow-wrap: break-word; }
  .metadata-values a { color: var(--primary); text-decoration: none; }
  .metadata-values a:hover { text-decoration: underline; }

  /* Below the site's main breakpoint the two columns stack, so values sit under
     their field name instead of being squeezed against the screen edge. */
  @media (max-width: 640px) {
    .metadata-table,
    .metadata-table tbody,
    .metadata-table tr,
    .metadata-table th,
    .metadata-table td { display: block; width: 100%; }
    .metadata-table th {
      padding: 0.6rem 0 0.1rem;
      white-space: normal;
    }
    .metadata-table td { padding: 0 0 0.35rem; }
    .metadata-table tr:not(:last-child) td {
      border-bottom: 1px solid var(--card-background-color);
      padding-bottom: 0.6rem;
    }
  }
</style>
