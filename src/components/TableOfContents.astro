---
/**
 * TableOfContents.astro — an "On this page" table-of-contents component with
 * a desktop sticky aside in the right rail and a collapsible details block
 * above content on narrow screens.
 *
 * Renders the same heading list in two variants:
 *  - "mobile": a collapsible <details> shown above the content on narrow
 *    viewports (hidden on wide screens, where the sticky aside takes over).
 *  - "desktop": a sticky aside list shown in the right rail on wide screens.
 *
 * A single scrollspy script (see <script> below) watches the headings of
 * every rendered list and marks the section currently in view with
 * aria-current="location", which the styles highlight.
 */

interface Heading {
  text: string;
  slug: string;
  depth: number;
}

interface Props {
  headings: Heading[];
  title?: string;
  variant: 'mobile' | 'desktop';
  /** The page title; shown as the first TOC item linking to the top of the page. */
  pageTitle?: string;
}

const { headings, title = 'On this page', variant, pageTitle } = Astro.props;
const has = headings.length > 0 || Boolean(pageTitle);
const displayHeadings = pageTitle
  ? [{ text: pageTitle, slug: 'top', depth: 1 }, ...headings]
  : headings;
---
{
  has && variant === 'mobile' && (
    <details class="toc-mobile" data-toc-container data-state-key="toc-mobile">
      <summary class="toc-summary">
        <span>{title}</span>
      </summary>
      <nav class="toc-body" aria-label={title}>
        <ul class="toc-list" data-toc>
          {displayHeadings.map((h) => (
            <li data-depth={h.depth}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  )
}
{
  has && variant === 'desktop' && (
    <details class="toc-desktop" open data-toc-container data-state-key="toc-desktop">
      <summary class="toc-title">{title}</summary>
      <nav class="toc-body-desktop" aria-label={title}>
        <ul class="toc-list" data-toc>
          {displayHeadings.map((h) => (
            <li data-depth={h.depth}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  )
}

<style>
  /* === Mobile collapsible TOC (above content, narrow screens) === */
  .toc-mobile {
    margin: 0 0 1.5rem 0;
    border: 1px solid var(--card-border-color);
    border-radius: 8px;
    background: var(--card-background-color);
  }
  .toc-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 1rem;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color);
    list-style: none;
  }
  .toc-summary::-webkit-details-marker { display: none; }
  /* Keep Pico's native summary::after chevron as the single expand arrow, and
     ensure it shows in its default (closed) state. */
  .toc-summary::after {
    display: block;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    margin-inline-start: 0.5rem;
  }
  .toc-body { border-top: 1px solid var(--card-border-color); padding: 0.4rem 0.75rem 0.75rem; }

  /* === Desktop TOC (right rail, wide screens) ===
     The right rail is a sticky flex column. This TOC is the primary flex item:
     it grows to fill the available column space (so it has plenty of vertical
     room), and scrolls internally if its content is taller than what's left.
     The recent-activity rail below it keeps a guaranteed 14rem floor. */
  .toc-desktop {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    margin: 0 0 0.5rem 0;
  }
  .toc-title {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted-color);
    margin: 0 0 0.5rem 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--card-border-color);
    cursor: pointer;
    list-style: none;
  }
  .toc-title::-webkit-details-marker { display: none; }

  /* === Shared list === */
  /* Pico's global reset sets `ul { display: flex }` and `nav ul { display: flex }`,
     which would lay the items out in a horizontal row, and sets
     `ul li { list-style: square }` directly on each li (white box markers).
     Force block + list-style:none on the li's so the list stacks vertically
     with no bullets. */
  .toc-list {
    display: block;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc-list li { display: list-item; list-style: none; }
  .toc-list a {
    display: block;
    font-size: 0.85rem;
    line-height: 1.35;
    padding: 0.22rem 0.6rem;
    color: var(--muted-color);
    text-decoration: none;
    border-radius: 4px;
    border-left: 2px solid transparent;
  }
  .toc-list a:hover { color: var(--primary); }
  .toc-list a[aria-current='location'] {
    color: var(--primary);
    font-weight: 600;
    border-left-color: var(--primary);
  }
  .toc-list li[data-depth='3'] a { padding-left: 1.2rem; font-size: 0.8rem; }
  .toc-list li[data-depth='4'] a { padding-left: 1.8rem; font-size: 0.78rem; }

  /* Hide the desktop aside on narrow screens (mobile <details> takes over),
     and hide the mobile details on wide screens (desktop aside takes over) —
     the desktop TOC only exists in the wide right rail. */
  @media (max-width: 1279.98px) {
    .toc-desktop { display: none; }
  }
  @media (min-width: 1280px) {
    .toc-mobile { display: none; }
  }
</style>

<script>
  // Scrollspy: watches the headings of every [data-toc] list on the page and
  // marks the section in view with aria-current="location".
  const TRIGGER_OFFSET = 80;
  document.querySelectorAll<HTMLElement>('[data-toc]').forEach((list) => {
    const entries = Array.from(list.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'))
      .map((link) => {
        const id = decodeURIComponent(link.hash.slice(1));
        const heading = id ? document.getElementById(id) : null;
        return heading ? { heading, link } : null;
      })
      .filter((e): e is { heading: HTMLElement; link: HTMLAnchorElement } => e !== null);
    if (!entries.length) return;

    let current: HTMLAnchorElement | null = null;

    const update = () => {
      const scrolledToBottom =
        window.innerHeight + window.scrollY >=
        document.documentElement.scrollHeight - 2;
      let active = entries[0].link;
      if (scrolledToBottom) {
        active = entries[entries.length - 1].link;
      } else {
        for (const { heading, link } of entries) {
          if (heading.getBoundingClientRect().top <= TRIGGER_OFFSET) active = link;
        }
      }
      if (active === current) return;
      current?.removeAttribute('aria-current');
      active.setAttribute('aria-current', 'location');
      current = active;

      // Keep the active item visible inside a scrollable desktop TOC as the
      // page scrolls. Only the desktop TOC is scrollable; skip the mobile one.
      const scroller = active.closest('.toc-desktop');
      if (!scroller || scroller.scrollHeight <= scroller.clientHeight) return;
      const linkRect = active.getBoundingClientRect();
      const box = scroller.getBoundingClientRect();
      // If the active link is above or below the visible TOC area, scroll the
      // TOC (not the page) so the link comes into view.
      const withinTop = linkRect.top - box.top;
      const withinBottom = box.bottom - linkRect.bottom;
      if (withinTop < 0 || withinBottom < 0) {
        const delta = withinTop < 0 ? withinTop : -withinBottom;
        scroller.scrollTop += delta;
      }
    };

    const observer = new IntersectionObserver(update, {
      rootMargin: `-${TRIGGER_OFFSET}px 0px -70% 0px`,
      threshold: 0,
    });
    for (const { heading } of entries) observer.observe(heading);

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    update();
  });
</script>
