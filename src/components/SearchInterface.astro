---
// The search interface: input, facet filters, chips, status, results.
//
// One component, two mounts (the /search page and the 404 page) so the two
// cannot drift. The interface is a custom controller over Pagefind's
// documented low-level API (see src/lib/search/*); it replaces the previous
// web-component wiring (private getInstanceManager access, MutationObserver
// label patching, 5.5 s fixed restoration delay, 200 ms readiness polling).
//
// URL contract: readable repeated parameters (?q=...&page_type=faq&level=...),
// legacy ?f=<base64 JSON> still accepted and normalized (never re-emitted).
import { getCollection } from 'astro:content';
import { strings } from '../i18n';
import { searchChrome, searchFilterBar, type SearchChrome } from '../i18n/searchLabels';
import { FACET_DISPLAY_ORDER } from '../data/facetVocab';
import { taxonomyHeading } from '../i18n/config';

const { locale = 'en' } = Astro.props;
const s = strings(locale).search;
const chrome = searchChrome(locale);
const filterBar = searchFilterBar(locale);

// Concept-slug -> localized title for topic-facet value display.
const concepts = await getCollection('concepts');
const conceptTitles: Record<string, string> = {};
for (const c of concepts) {
  conceptTitles[c.id.replace(/\.md$/, '')] = c.data.title;
}

// Facet order: primary filters visible first; everything else (research
// method, page kind, the seven topic vocabularies) behind "More filters".
const PRIMARY_FACETS = ['page_type', 'audience', 'level', 'discipline'];
const MORE_FACETS = ['research_method', 'page_kind', ...FACET_DISPLAY_ORDER];
const facetLabel = (facet: string): string => {
  const found = filterBar.find((f) => f.filter === facet);
  if (found) return found.label;
  const raw = facet;
  return taxonomyHeading(raw === 'page_kind' ? 'page_kind' : raw, locale);
};

// Localized index links for the no-JS fallback and the empty state.
const l = locale === 'en' ? '' : `/${locale}`;
const indexHrefs = {
  concepts: `/aied${l}/concepts/`,
  faqs: `/aied${l}/faqs/`,
  resources: `/aied${l}/resources/`,
};

const config: SearchChrome & {
  basePath: string;
  facetLabel: Record<string, string>;
  conceptTitles: Record<string, string>;
  indexHrefs: Record<string, string>;
} = {
  ...chrome,
  basePath: '/aied',
  facetLabel: Object.fromEntries([...PRIMARY_FACETS, ...MORE_FACETS].map((f) => [f, facetLabel(f)])),
  conceptTitles,
  indexHrefs,
};
const languageName =
  locale === 'en'
    ? 'English'
    : new Intl.DisplayNames(['en'], { type: 'language' }).of(locale) ?? locale;
---

<div class="search-interface" data-search-interface data-locale={locale}>
  <noscript>
    <section class="search-nojs">
      <h2>{chrome.labels.nojs_title}</h2>
      <p>{chrome.labels.nojs_text}</p>
      <ul>
        <li><a href={indexHrefs.concepts}>{chrome.labels.concepts}</a></li>
        <li><a href={indexHrefs.faqs}>{chrome.labels.faqs}</a></li>
        <li><a href={indexHrefs.resources}>{chrome.labels.resources}</a></li>
      </ul>
    </section>
  </noscript>

  <form role="search" class="search-form" data-search-form novalidate>
    <label class="visually-hidden" for="aied-search-input">{chrome.labels.search}</label>
    <input
      id="aied-search-input"
      name="q"
      type="search"
      class="search-input"
      data-search-q
      autocomplete="off"
      maxlength="500"
      placeholder={s.placeholder}
    />
    <button type="submit" class="search-button" data-search-submit>{chrome.labels.submit}</button>
    <button type="button" class="search-button search-button-ghost" data-search-clear-query hidden>
      {chrome.labels.clear_query}
    </button>
    <button type="button" class="search-button search-button-ghost" data-search-share>
      {chrome.labels.share}
    </button>
  </form>

  {locale !== 'en' && (
    <p class="search-locale-note">
      {chrome.labels.searching_language.replace('{language}', languageName)}{' '}
      <a data-search-english href="/aied/search/">{chrome.labels.english_fallback}</a>
    </p>
  )}

  <div class="search-filter-row search-filter-primary">
    {PRIMARY_FACETS.map((facet) => (
      <details class="search-facet" data-filter-group={facet}>
        <summary>
          <span class="search-facet-label">{config.facetLabel[facet]}</span>
          <span class="search-facet-count" data-filter-count hidden></span>
        </summary>
        <fieldset class="search-facet-body">
          <legend class="visually-hidden">{config.facetLabel[facet]}</legend>
          <div class="search-filter-options" data-filter-options></div>
        </fieldset>
      </details>
    ))}
  </div>

  <details class="search-more-filters" data-search-more-filters>
    <summary>{chrome.labels.more_filters}</summary>
    <div class="search-filter-row search-filter-more">
      {MORE_FACETS.map((facet) => (
        <details class="search-facet" data-filter-group={facet}>
          <summary>
            <span class="search-facet-label">{config.facetLabel[facet]}</span>
            <span class="search-facet-count" data-filter-count hidden></span>
          </summary>
          <fieldset class="search-facet-body">
            <legend class="visually-hidden">{config.facetLabel[facet]}</legend>
            <div class="search-filter-options" data-filter-options></div>
          </fieldset>
        </details>
      ))}
    </div>
  </details>

  <div class="search-chip-row">
    <div class="search-chips" data-search-chips role="group" aria-label={chrome.labels.share}></div>
    <button type="button" class="search-button search-button-ghost" data-search-clear-filters>
      {chrome.labels.clear_filters}
    </button>
    <button type="button" class="search-button search-button-ghost" data-search-clear-all>
      {chrome.labels.clear_all}
    </button>
  </div>

  <p class="search-status" data-search-status role="status" aria-live="polite"></p>
  <p class="search-summary" data-search-summary></p>
  <a class="search-skip" href="#aied-search-results" data-search-skip>
    {chrome.labels.skip_results}
  </a>

  <ol class="search-results" data-search-results id="aied-search-results"></ol>
  <button type="button" class="search-button" data-search-load-more hidden>
    {chrome.labels.load_more}
  </button>

  <div class="search-empty" data-search-empty hidden>
    <h2>{chrome.labels.empty_title}</h2>
    <p data-empty-hits hidden>{chrome.labels.empty_hits}</p>
    <section class="search-suggestions">
      <h3>{chrome.labels.suggestions}</h3>
      <div class="search-suggestion-queries" data-suggestion-queries></div>
      <ul>
        <li><a href={indexHrefs.concepts}>{chrome.labels.concepts}</a></li>
        <li><a href={indexHrefs.faqs}>{chrome.labels.faqs}</a></li>
        <li><a href={indexHrefs.resources}>{chrome.labels.resources}</a></li>
      </ul>
    </section>
  </div>

  <div class="search-error" data-search-error role="alert" hidden>
    <p data-error-text></p>
    <button type="button" class="search-button" data-search-retry>{chrome.labels.retry}</button>
  </div>

  <p id="aied-search-announce" class="visually-hidden" data-search-a11y-announce aria-live="assertive"></p>

  <script type="application/json" id="aied-search-config" set:html={JSON.stringify(config)}></script>
</div>

<script>
  import { SearchController } from '../lib/search/controller.ts';
  const cfg = JSON.parse(document.getElementById('aied-search-config')!.textContent!);
  (window as any).__AIED_BASE_PATH__ = cfg.basePath;
  const root = document.querySelector<HTMLElement>('[data-search-interface]')!;
  new SearchController(root, cfg);
</script>

<style>
  .search-interface {
    max-width: 800px;
    margin: 0 auto;
  }
  .search-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 1.25rem;
  }
  .search-input {
    flex: 1 1 14rem;
    min-width: 0;
    padding: 0.65rem 0.8rem;
    font-size: 1.05rem;
    border: 2px solid var(--card-border-color);
    border-radius: 6px;
    background: var(--card-background-color);
    color: var(--color);
  }
  .search-input:focus-visible {
    border-color: var(--primary);
    outline: none;
  }
  .search-button {
    /* Pico's global `button { display:block; width:100% }` is why the
       first implementation rendered Search/Clear/Share as full-width bars.
       Keep these compact, inline controls. */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    margin: 0;
    padding: 0.55rem 0.9rem;
    font-size: 0.9rem;
    line-height: 1.2;
    border: 2px solid var(--card-border-color);
    border-radius: 6px;
    background: var(--card-background-color);
    color: var(--color);
    cursor: pointer;
  }
  .search-button:hover,
  .search-button:focus-visible {
    border-color: var(--primary);
  }
  .search-button-ghost {
    background: transparent;
  }
  .search-locale-note {
    margin: -0.5rem 0 0.9rem;
    font-size: 0.85rem;
    color: var(--muted-color);
  }
  .search-filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.5rem 0.75rem;
    margin-bottom: 0.75rem;
  }
  .search-facet {
    position: relative;
    min-width: 9rem;
    max-width: 16rem;
  }
  .search-facet > summary,
  .search-more-filters > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    padding: 0.45rem 0.75rem;
    font-size: 0.86rem;
    font-weight: 600;
    border: 2px solid var(--card-border-color);
    border-radius: 6px;
    background: var(--card-background-color);
    color: var(--color);
    list-style: none;
    min-height: 40px;
  }
  .search-facet > summary::-webkit-details-marker,
  .search-more-filters > summary::-webkit-details-marker {
    display: none;
  }
  .search-facet > summary::after,
  .search-more-filters > summary::after {
    content: '▾';
    font-size: 0.7rem;
    color: var(--muted-color);
  }
  .search-facet[open] > summary,
  .search-more-filters[open] > summary {
    border-color: var(--primary);
  }
  .search-facet-count {
    min-width: 1.2rem;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: var(--primary);
    color: var(--background-color, #fff);
    font-size: 0.72rem;
    text-align: center;
  }
  /* A closed <details> only hides its content through the UA stylesheet;
     an author `display` rule on the child wins. Hide it explicitly so the
     disclosure actually collapses. */
  .search-facet:not([open]) .search-facet-body,
  .search-facet:not([open]) .search-filter-options,
  .search-more-filters:not([open]) .search-filter-more {
    display: none;
  }
  .search-facet-body {
    position: absolute;
    z-index: 20;
    top: calc(100% + 0.3rem);
    left: 0;
    width: max-content;
    min-width: 12rem;
    max-width: min(20rem, 70vw);
    margin: 0;
    padding: 0.6rem 0.75rem;
    border: 2px solid var(--card-border-color);
    border-radius: 8px;
    background: var(--card-background-color);
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.25);
  }
  .search-filter-options {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    max-height: 16rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .search-option {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    padding: 0.15rem 0;
    min-height: 32px; /* touch target floor */
  }
  .search-more-filters > summary {
    margin-bottom: 0.6rem;
  }
  .search-filter-more {
    margin-bottom: 0.75rem;
  }
  .search-chip-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .search-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .search-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    font-size: 0.82rem;
    border: 1px solid var(--card-border-color);
    border-radius: 999px;
    background: color-mix(in srgb, var(--primary) 12%, transparent);
    color: var(--color);
    cursor: pointer;
    min-height: 36px;
  }
  .search-chip:hover,
  .search-chip:focus-visible {
    border-color: var(--primary);
  }
  .search-status,
  .search-summary {
    color: var(--muted-color);
    font-size: 0.9rem;
    margin: 0.25rem 0;
    min-height: 1.2em;
  }
  .search-skip {
    display: block;
    margin: 0.25rem 0 0.75rem;
    color: var(--primary);
    font-size: 0.85rem;
  }
  .search-results {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .search-result {
    padding: 1rem 0;
    border-bottom: 1px solid var(--card-border-color);
  }
  .search-result-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
  }
  .search-result-type {
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--card-border-color);
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--muted-color);
    white-space: nowrap;
  }
  .search-result-link {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--primary);
    text-decoration: none;
  }
  .search-result-link:hover,
  .search-result-link:focus-visible {
    text-decoration: underline;
  }
  .search-result-excerpt {
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--muted-color);
  }
  .search-result-excerpt mark {
    background: color-mix(in srgb, var(--primary) 30%, transparent);
    color: inherit;
    border-radius: 2px;
    padding: 0 1px;
  }
  .search-result-meta {
    margin-top: 0.35rem;
    font-size: 0.8rem;
    color: var(--muted-color);
  }
  .search-empty,
  .search-error {
    margin: 1.5rem 0;
    padding: 1rem;
    border: 2px dashed var(--card-border-color);
    border-radius: 8px;
  }
  .search-error {
    border-style: solid;
    border-color: var(--danger, #b3503a);
  }
  .search-suggestions ul {
    margin: 0.5rem 0 0;
    padding-left: 1.2rem;
  }
  .search-suggestion-queries {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .search-suggestion-query {
    padding: 0.35rem 0.7rem;
    font-size: 0.85rem;
    border: 1px solid var(--card-border-color);
    border-radius: 999px;
    background: transparent;
    color: var(--primary);
    cursor: pointer;
    min-height: 36px;
  }
  .search-share-fallback {
    width: 100%;
    margin: 0.5rem 0;
    padding: 0.5rem;
    font: 0.85rem monospace;
    border: 1px solid var(--card-border-color);
    border-radius: 6px;
  }
  .search-nojs h2 {
    font-size: 1.1rem;
  }
  .visually-hidden {
    position: absolute !important;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 360px) {
    .search-form .search-button {
      flex: 1 1 auto;
    }
  }
</style>
