---
/**
 * Header overflow menu.
 *
 * The header row holds every control it has room for; when they stop fitting, the
 * layout moves the lowest-priority ones in here, so the menu's contents are exactly
 * whatever did not fit at the current width — icons only, each keeping its
 * accessible name and tooltip. The chevron itself is hidden while the row fits
 * everything, so a wide screen shows no overflow control at all.
 */
import { strings } from '../i18n';

const { locale = 'en' } = Astro.props;
const ui = strings(locale).ui;
---

<div class="more-menu" data-more-menu hidden>
  <button
    type="button"
    class="header-icon more-toggle"
    data-more-toggle
    aria-haspopup="true"
    aria-expanded="false"
    aria-label={ui.more}
    title={ui.more}
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="m7 6 5 5 5-5"></path>
      <path d="m7 13 5 5 5-5"></path>
    </svg>
  </button>

  <div class="more-panel" data-more-panel hidden role="menu" aria-label={ui.more}>
    <div class="more-slot" data-overflow-slot></div>
  </div>
</div>

<style>
  .more-menu {
    position: relative;
    display: inline-flex;
  }
  /* Same box as the header row icons (they are styled in the layout, which cannot
     reach a button rendered by this component). */
  .more-toggle {
    width: 2.6rem;
    height: 2.6rem;
    margin: 0;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--muted-color);
    border: 1px solid var(--muted-border-color);
    border-radius: 8px;
    background: transparent;
    font: inherit;
    line-height: 1;
    box-shadow: none;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .more-toggle:hover,
  .more-toggle:focus-visible {
    color: var(--primary);
    border-color: var(--primary);
    background: color-mix(in srgb, var(--primary) 10%, transparent);
    outline: none;
  }
  .more-panel {
    position: absolute;
    top: calc(100% + 0.4rem);
    inset-inline-end: 0;
    z-index: 60;
    min-width: 0;
    max-width: calc(100vw - 1.5rem);
    max-height: min(70dvh, 32rem);
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0.35rem;
    border: 1px solid var(--card-border-color);
    border-radius: 8px;
    background: var(--card-background-color);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
  }
  .more-panel[hidden] {
    display: none;
  }
  /* Items that did not fit the row: one icon per row, no visible labels. Each row is
     the control's own box, so centre its glyph exactly as the header row does — a
     flex-start override here sits the link icons ~6px left of the language globe,
     because that control carries its own inline padding. */
  .more-slot {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.15rem;
  }
  .more-slot :global(a),
  .more-slot :global(button) {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .more-slot :global(.lang-switcher) {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* The globe button's own inline padding is what offsets it inside its box; drop it
     in the panel so its glyph lands on the same centre line as the rows above. */
  .more-slot :global(.lang-toggle) {
    padding-inline: 0;
    justify-content: center;
  }
</style>

<script>
  // Open/close on the button, close on an outside click, on Escape, or after a
  // control inside it is used. What the slot holds is the layout script's business.
  document.querySelectorAll('[data-more-menu]').forEach((root) => {
    const btn = root.querySelector('[data-more-toggle]') as HTMLButtonElement | null;
    const panel = root.querySelector('[data-more-panel]') as HTMLElement | null;
    if (!btn || !panel) return;
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
    };
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(panel.hidden);
    });
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (!panel.hidden && !root.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        btn.focus();
      }
    });
  });
</script>