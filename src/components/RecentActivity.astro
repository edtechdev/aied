---
/**
 * RecentActivity.astro — the "Recently Added Articles" and "Recently Updated
 * Concepts" sidebar lists. Rendered once in BaseLayout's right rail, after the
 * on-this-page TOC when present. On mobile the right rail stacks below the page
 * content (single-column grid), so this shows below the article/concept page.
 */
interface Item {
  title: string;
  url: string;
  date: string;
}

interface Props {
  articles: Item[];
  concepts: Item[];
}

const { articles, concepts } = Astro.props;
---

<style>
  .recent-block { margin-bottom: 1rem; }
  .recent-block summary {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted-color);
    margin: 0 0 0.6rem 0;
    cursor: pointer;
    list-style: none;
  }
  .recent-block summary::-webkit-details-marker { display: none; }
  .recent-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .recent-list li {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--muted-border-color);
  }
  .recent-list li:last-child { border-bottom: none; }
  .recent-list a {
    display: block;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color);
    text-decoration: none;
    line-height: 1.35;
  }
  .recent-list a:hover { color: var(--primary); }
  .recent-date {
    display: block;
    font-size: 0.75rem;
    color: var(--muted-color);
    margin-top: 0.1rem;
  }
  .recent-more { margin: 0.6rem 0 0 0; }
  .recent-more a { font-size: 0.82rem; }
</style>

<details class="recent-block" open data-state-key="recent:articles">
  <summary><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline-block;vertical-align:-0.15em;margin-right:0.35rem;"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M16 13H8"></path><path d="M16 17H8"></path><path d="M10 9H8"></path></svg>Recently Added Articles</summary>
  <ul class="recent-list">
    {articles.map(a => (
      <li>
        <a href={a.url}>{a.title}</a>
        <span class="recent-date">{a.date}</span>
      </li>
    ))}
  </ul>
  <p class="recent-more"><a href="/aied/journal">View all articles →</a></p>
</details>

<details class="recent-block" open data-state-key="recent:concepts">
  <summary><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline-block;vertical-align:-0.15em;margin-right:0.35rem;"><line x1="9" y1="18" x2="15" y2="18"></line><line x1="10" y1="22" x2="14" y2="22"></line><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5.76.76 1.23 1.52 1.41 2.5z"></path></svg>Recently Updated Concepts</summary>
  <ul class="recent-list">
    {concepts.map(c => (
      <li>
        <a href={c.url}>{c.title}</a>
        <span class="recent-date">{c.date}</span>
      </li>
    ))}
  </ul>
</details>
