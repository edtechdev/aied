---
// Concept map for the homepage: a radial SVG with "AI in Education" at the center
// and top-level umbrella concepts arranged around it. Each node links to its
// concept page. Dark background, uniform node color, rounded rectangles, accessible.
// Some related sub-nodes are interconnected (e.g. Assessment <-> Feedback).

// Central hub
const center = { slug: 'ai-education', label: 'AI in Education' };

// Outer umbrella nodes (concept slug, short display label)
// All share the site's light-blue accent color.
const nodes = [
  { slug: 'intelligent-tutoring',     label: 'Tutoring' },
  { slug: 'learning-theories',        label: 'Learning' },
  { slug: 'assessment',               label: 'Assessment' },
  { slug: 'feedback',                 label: 'Feedback' },
  { slug: 'ai-literacy',              label: 'AI Literacy' },
  { slug: 'equity-in-ai-education',   label: 'Equity' },
  { slug: 'discipline-specific-aied', label: 'Disciplines' },
  { slug: 'instructional-design',     label: 'Instruction' },
  { slug: 'academic-integrity',       label: 'Academic Integrity' },
  { slug: 'agentic-ai',               label: 'Agents' },
  { slug: 'ai-ed-evaluation',         label: 'Evaluation' },
  { slug: 'research-methods-aied',    label: 'Research' },
];

// Related sub-node pairs to interconnect (by slug)
const subLinks = [
  ['assessment', 'feedback'],
  ['assessment', 'ai-ed-evaluation'],
  ['learning-theories', 'instructional-design'],
  ['intelligent-tutoring', 'agentic-ai'],
  ['ai-ed-evaluation', 'research-methods-aied'],
];

// geometry
const CX = 450, CY = 350;
const R = 250; // ring radius
const RECT_W = 104, RECT_H = 40; // uniform rounded-rect size
const n = nodes.length;

const placed = nodes.map((node, i) => {
  const angle = -90 + (360 / n) * i; // degrees from top, clockwise
  const rad = (angle * Math.PI) / 180;
  return { ...node, x: CX + R * Math.cos(rad), y: CY + R * Math.sin(rad) };
});
const bySlug: Record<string, { x: number; y: number }> = {};
placed.forEach((p) => { bySlug[p.slug] = { x: p.x, y: p.y }; });

// hub spokes: center to each node
const spokes = placed.map((p) => ({ x1: CX, y1: CY, x2: p.x, y2: p.y }));
// inter-node connections (drawn as lighter secondary lines)
const edges = subLinks
  .map(([a, b]) => ({ a: bySlug[a], b: bySlug[b] }))
  .filter((e) => e.a && e.b);

const centerNode = { ...center, x: CX, y: CY };

// font size scales down for long labels so they fit the uniform rect width
function labelFont(label: string): number {
  return label.length >= 16 ? 10 : 12;
}
---
<svg
  class="concept-map"
  viewBox="0 0 900 700"
  role="img"
  aria-labelledby="concept-map-title concept-map-desc"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="concept-map-title">Concept map of AI in Education</title>
  <desc id="concept-map-desc">
    A radial map with AI in Education at the center, connected by lines to twelve top-level
    concepts: Tutoring, Learning, Assessment, Feedback, AI Literacy, Equity, Disciplines,
    Instruction, Academic Integrity, Agents, Evaluation, and Research.
    Related concepts such as Assessment and Feedback are also interconnected.
    Select any node to open that concept's page.
  </desc>

  <!-- background card matching the site's dark theme -->
  <rect x="0" y="0" width="900" height="700" rx="16" fill="#0d1418" />

  <!-- hub spokes: center to each node -->
  {spokes.map((l) => (
    <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke="#2c3a45" stroke-width="2" />
  ))}

  <!-- inter-node connections (secondary) -->
  {edges.map((e) => (
    <line x1={e.a.x} y1={e.a.y} x2={e.b.x} y2={e.b.y} stroke="#3a4a58" stroke-width="1.5" stroke-dasharray="4 4" />
  ))}

  <!-- center node (clickable) -->
  <a href={`/aied/concepts/${centerNode.slug}/`}>
    <g class="concept-map-node">
      <rect x={CX - 78} y={CY - 27} width="156" height="54" rx="14" fill="#0b1220" stroke="#7dd3fc" stroke-width="3" />
      <text x={CX} y={CY + 6} text-anchor="middle" fill="#e8eef2" font-size="15" font-weight="700" font-family="inherit">AI in Education</text>
    </g>
  </a>

  <!-- outer nodes (clickable rounded rectangles) -->
  {placed.map((p) => (
    <a href={`/aied/concepts/${p.slug}/`}>
      <g class="concept-map-node">
        <rect x={p.x - RECT_W / 2} y={p.y - RECT_H / 2} width={RECT_W} height={RECT_H} rx="12" fill="#7dd3fc" />
        <rect x={p.x - RECT_W / 2} y={p.y - RECT_H / 2} width={RECT_W} height={RECT_H} rx="12" fill="none" stroke="#0d1418" stroke-width="2" />
        <text x={p.x} y={p.y + 5} text-anchor="middle" fill="#0b1220" font-size={labelFont(p.label)} font-weight="700" font-family="inherit">{p.label}</text>
      </g>
    </a>
  ))}
</svg>

<style>
  .concept-map {
    display: block;
    width: 100%;
    max-width: 900px;
    height: auto;
    margin: 0 auto 1.75rem auto;
    border-radius: 16px;
    border: 1px solid var(--muted-border-color);
    background: #0d1418;
  }
  .concept-map a { cursor: pointer; }
  .concept-map .concept-map-node {
    transition: opacity 0.15s ease;
  }
  .concept-map a:hover .concept-map-node,
  .concept-map a:focus-visible .concept-map-node {
    opacity: 0.9;
  }
  .concept-map a:focus-visible .concept-map-node rect:last-of-type {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
</style>
