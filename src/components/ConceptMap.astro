---
// Concept map for the homepage: a radial SVG with "AI in Education" at the center
// and top-level umbrella concepts arranged in two tight rings around it. Each node
// links to its concept page. Dark background, uniform light-blue color, rounded
// rectangles, larger type, no inter-node lines. On small screens a legible
// flex-wrap list of the same links is shown instead of the scaled-down SVG.

// Labels arrive as copy from the page (src/i18n/pages/home.<locale>.ts), so the map
// reads in the active language; the English labels below are the fallback for a
// locale that has not translated the map yet.
const { copy } = Astro.props;

const FALLBACK = {
  title: 'Concept map of AI in Education',
  desc: 'A radial map with AI in Education at the center, connected to twelve top-level concepts.',
  navLabel: 'AI in Education concepts',
  center: 'AI in Education',
  nodes: {} as Record<string, string>,
};
const c = { ...FALLBACK, ...(copy ?? {}) };
const label = (slug: string, english: string) => c.nodes[slug] ?? english;

const center = { slug: 'ai-education', label: c.center };

// Outer umbrella nodes (concept slug, short display label) — two rings
const inner = [
  { slug: 'student-modeling',        label: label('student-modeling', 'Modeling') },
  { slug: 'learning-theories',        label: label('learning-theories', 'Learning') },
  { slug: 'equity-in-ai-education',   label: label('equity-in-ai-education', 'Equity') },
  { slug: 'feedback',                 label: label('feedback', 'Feedback') },
  { slug: 'ai-literacy',              label: label('ai-literacy', 'AI Literacy') },
  { slug: 'assessment',               label: label('assessment', 'Assessment') },
];
const outer = [
  { slug: 'discipline-specific-aied', label: label('discipline-specific-aied', 'Disciplines') },
  { slug: 'pedagogy',                   label: label('pedagogy', 'Pedagogy') },
  { slug: 'ethics',                   label: label('ethics', 'Ethics') },
  { slug: 'ai-technologies',         label: label('ai-technologies', 'Technologies') },
  { slug: 'ai-ed-evaluation',         label: label('ai-ed-evaluation', 'Evaluation') },
  { slug: 'research-methods-aied',    label: label('research-methods-aied', 'Research') },
];

// geometry
const CX = 450, CY = 375;
const RECT_W = 138, RECT_H = 48;
const FONT = 16, FONT_SMALL = 13, FONT_TINY = 11;

function ring(ringNodes: typeof inner, radius: number, startDeg: number) {
  const n = ringNodes.length;
  return ringNodes.map((node, i) => {
    const angle = (startDeg + (360 / n) * i) * (Math.PI / 180);
    return { ...node, x: CX + radius * Math.cos(angle), y: CY + radius * Math.sin(angle) };
  });
}
// inner ring nodes shifted to sit between outer nodes for a tight staggered layout
const innerPlaced = ring(inner, 168, 30);
const outerPlaced = ring(outer, 280, 0);

const allPlaced = [...innerPlaced, ...outerPlaced];
const spokes = allPlaced.map((p) => ({ x1: CX, y1: CY, x2: p.x, y2: p.y }));

// Labels vary a lot in length once translated (German compounds, Japanese
// compounds), and the boxes are fixed, so step the type size down rather than
// letting a long label spill outside its rectangle. Counted in code points so a
// multi-byte script is not penalised per byte.
// The center label sits in a 190px box at a fixed size; translated names can be
// nearly twice the English length, so it steps down too.
const centerFont = [...center.label].length >= 16 ? 15 : 20;

function labelFont(label: string): number {
  const n = [...label].length;
  if (n >= 17) return FONT_TINY;
  return n >= 12 ? FONT_SMALL : FONT;
}
---
<!-- Desktop / tablet: radial SVG -->
<div class="concept-map-wrap">
  <svg
    class="concept-map"
    viewBox="0 0 900 750"
    role="img"
    aria-labelledby="concept-map-title concept-map-desc"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id="concept-map-title">{c.title}</title>
    <desc id="concept-map-desc">{c.desc}</desc>
    <!-- background card matching the site's theme -->
    <rect x="0" y="0" width="900" height="750" rx="16" fill="var(--cmap-bg)" />

    <!-- hub spokes: center to each node -->
    {spokes.map((l) => (
      <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke="var(--cmap-spoke)" stroke-width="2" />
    ))}

    <!-- center node (clickable) -->
    <a href={`/aied/concepts/${center.slug}/`}>
      <g class="concept-map-node">
        <rect x={CX - 95} y={CY - 31} width="190" height="62" rx="16" fill="#7dd3fc" />
        <rect x={CX - 95} y={CY - 31} width="190" height="62" rx="16" fill="none" stroke="#0d1418" stroke-width="2" />
        <text x={CX} y={CY + 7} text-anchor="middle" fill="#0b1220" font-size={centerFont} font-weight="700" font-family="inherit">{center.label}</text>
      </g>
    </a>

    <!-- outer nodes (clickable rounded rectangles) -->
    {allPlaced.map((p) => (
      <a href={`/aied/concepts/${p.slug}/`}>
        <g class="concept-map-node">
          <rect x={p.x - RECT_W / 2} y={p.y - RECT_H / 2} width={RECT_W} height={RECT_H} rx="14" fill="#7dd3fc" />
          <rect x={p.x - RECT_W / 2} y={p.y - RECT_H / 2} width={RECT_W} height={RECT_H} rx="14" fill="none" stroke="#0d1418" stroke-width="2" />
          <text x={p.x} y={p.y + 6} text-anchor="middle" fill="#0b1220" font-size={labelFont(p.label)} font-weight="700" font-family="inherit">{p.label}</text>
        </g>
      </a>
    ))}
  </svg>
</div>

<!-- Mobile: legible flex-wrap list of the same links -->
<nav class="concept-map-mobile" aria-label={c.navLabel}>
  <a class="concept-map-mobile-item concept-map-mobile-center" href={`/aied/concepts/${center.slug}/`}>{center.label}</a>
  {allPlaced.map((p) => (
    <a class="concept-map-mobile-item" href={`/aied/concepts/${p.slug}/`}>{p.label}</a>
  ))}
</nav>

<style>
  .concept-map-wrap {
    margin: 0 auto 1.75rem auto;
    max-width: 900px;
    --cmap-bg: #0d1418;
    --cmap-spoke: #2c3a45;
  }
  :root[data-theme=light] .concept-map-wrap {
    --cmap-bg: #ffffff;
    --cmap-spoke: #d3dbe1;
  }
  .concept-map {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px;
    border: 1px solid var(--muted-border-color);
    background: var(--cmap-bg);
  }
  .concept-map text {
    direction: inherit;
  }
  :global(html[dir='rtl']) .concept-map text {
    direction: rtl;
  }
  .concept-map a { cursor: pointer; }
  .concept-map .concept-map-node { transition: opacity 0.15s ease; }
  .concept-map a:hover .concept-map-node,
  .concept-map a:focus-visible .concept-map-node { opacity: 0.9; }
  .concept-map a:focus-visible .concept-map-node rect:last-of-type {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  /* Mobile fallback: hidden by default, shown on narrow screens */
  .concept-map-mobile {
    display: none;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 1rem;
    margin: 0 auto 1.75rem auto;
    max-width: 520px;
    background: var(--cmap-bg);
    border: 1px solid var(--muted-border-color);
    border-radius: 16px;
    justify-content: center;
  }
  .concept-map-mobile-item {
    display: inline-block;
    padding: 0.6rem 0.9rem;
    border-radius: 10px;
    background: #7dd3fc;
    color: #0b1220;
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.2;
    text-decoration: none;
    text-align: center;
  }
  .concept-map-mobile-center {
    background: #0b1220;
    color: #7dd3fc;
    border: 2px solid #7dd3fc;
  }
  :root[data-theme=light] .concept-map-mobile-center {
    background: #0284c7;
    color: #ffffff;
    border-color: #0284c7;
  }
  .concept-map-mobile-item:hover { opacity: 0.9; }

  @media (max-width: 640px) {
    .concept-map-wrap { display: none; }
    .concept-map-mobile { display: flex; }
  }
</style>
