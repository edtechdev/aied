---
// Concept map for the homepage: a radial SVG with "AI in Education" at the center
// and top-level umbrella concepts arranged in two tight rings around it. Each node
// links to its concept page. Dark background, uniform light-blue color, rounded
// rectangles, larger type, no inter-node lines. On small screens a legible
// flex-wrap list of the same links is shown instead of the scaled-down SVG.

const center = { slug: 'ai-education', label: 'AI in Education' };

// Outer umbrella nodes (concept slug, short display label) — two rings
const inner = [
  { slug: 'intelligent-tutoring',     label: 'Tutoring' },
  { slug: 'learning-theories',        label: 'Learning' },
  { slug: 'equity-in-ai-education',   label: 'Equity' },
  { slug: 'feedback',                 label: 'Feedback' },
  { slug: 'ai-literacy',              label: 'AI Literacy' },
  { slug: 'assessment',               label: 'Assessment' },
];
const outer = [
  { slug: 'discipline-specific-aied', label: 'Disciplines' },
  { slug: 'pedagogy',                   label: 'Pedagogy' },
  { slug: 'academic-integrity',       label: 'Academic Integrity' },
  { slug: 'ai-technologies',         label: 'Technologies' },
  { slug: 'ai-ed-evaluation',         label: 'Evaluation' },
  { slug: 'research-methods-aied',    label: 'Research' },
];

// geometry
const CX = 450, CY = 375;
const RECT_W = 138, RECT_H = 48;
const FONT = 16, FONT_SMALL = 13;

function ring(ringNodes: typeof inner, radius: number, startDeg: number) {
  const n = ringNodes.length;
  return ringNodes.map((node, i) => {
    const angle = (startDeg + (360 / n) * i) * (Math.PI / 180);
    return { ...node, x: CX + radius * Math.cos(angle), y: CY + radius * Math.sin(angle) };
  });
}
// inner ring nodes shifted to sit between outer nodes for a tight staggered layout
const innerPlaced = ring(inner, 168, 30);
const outerPlaced = ring(outer, 280, 0);

const allPlaced = [...innerPlaced, ...outerPlaced];
const spokes = allPlaced.map((p) => ({ x1: CX, y1: CY, x2: p.x, y2: p.y }));

function labelFont(label: string): number {
  return label.length >= 16 ? FONT_SMALL : FONT;
}
---
<!-- Desktop / tablet: radial SVG -->
<div class="concept-map-wrap">
  <svg
    class="concept-map"
    viewBox="0 0 900 750"
    role="img"
    aria-labelledby="concept-map-title concept-map-desc"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id="concept-map-title">Concept map of AI in Education</title>
    <desc id="concept-map-desc">
      A radial map with AI in Education at the center, connected to twelve top-level concepts:
      Tutoring, Learning, Assessment, Feedback, AI Literacy, Equity, Disciplines, Pedagogy,
      Academic Integrity, Technologies, Evaluation, and Research. Select any node to open its page.
    </desc>

    <!-- background card matching the site's dark theme -->
    <rect x="0" y="0" width="900" height="750" rx="16" fill="#0d1418" />

    <!-- hub spokes: center to each node -->
    {spokes.map((l) => (
      <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke="#2c3a45" stroke-width="2" />
    ))}

    <!-- center node (clickable) -->
    <a href={`/aied/concepts/${center.slug}/`}>
      <g class="concept-map-node">
        <rect x={CX - 95} y={CY - 31} width="190" height="62" rx="16" fill="#7dd3fc" />
        <rect x={CX - 95} y={CY - 31} width="190" height="62" rx="16" fill="none" stroke="#0d1418" stroke-width="2" />
        <text x={CX} y={CY + 7} text-anchor="middle" fill="#0b1220" font-size="20" font-weight="700" font-family="inherit">AI in Education</text>
      </g>
    </a>

    <!-- outer nodes (clickable rounded rectangles) -->
    {allPlaced.map((p) => (
      <a href={`/aied/concepts/${p.slug}/`}>
        <g class="concept-map-node">
          <rect x={p.x - RECT_W / 2} y={p.y - RECT_H / 2} width={RECT_W} height={RECT_H} rx="14" fill="#7dd3fc" />
          <rect x={p.x - RECT_W / 2} y={p.y - RECT_H / 2} width={RECT_W} height={RECT_H} rx="14" fill="none" stroke="#0d1418" stroke-width="2" />
          <text x={p.x} y={p.y + 6} text-anchor="middle" fill="#0b1220" font-size={labelFont(p.label)} font-weight="700" font-family="inherit">{p.label}</text>
        </g>
      </a>
    ))}
  </svg>
</div>

<!-- Mobile: legible flex-wrap list of the same links -->
<nav class="concept-map-mobile" aria-label="AI in Education concepts">
  <a class="concept-map-mobile-item concept-map-mobile-center" href={`/aied/concepts/${center.slug}/`}>AI in Education</a>
  {allPlaced.map((p) => (
    <a class="concept-map-mobile-item" href={`/aied/concepts/${p.slug}/`}>{p.label}</a>
  ))}
</nav>

<style>
  .concept-map-wrap {
    margin: 0 auto 1.75rem auto;
    max-width: 900px;
  }
  .concept-map {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px;
    border: 1px solid var(--muted-border-color);
    background: #0d1418;
  }
  .concept-map a { cursor: pointer; }
  .concept-map .concept-map-node { transition: opacity 0.15s ease; }
  .concept-map a:hover .concept-map-node,
  .concept-map a:focus-visible .concept-map-node { opacity: 0.9; }
  .concept-map a:focus-visible .concept-map-node rect:last-of-type {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  /* Mobile fallback: hidden by default, shown on narrow screens */
  .concept-map-mobile {
    display: none;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 1rem;
    margin: 0 auto 1.75rem auto;
    max-width: 520px;
    background: #0d1418;
    border: 1px solid var(--muted-border-color);
    border-radius: 16px;
    justify-content: center;
  }
  .concept-map-mobile-item {
    display: inline-block;
    padding: 0.6rem 0.9rem;
    border-radius: 10px;
    background: #7dd3fc;
    color: #0b1220;
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.2;
    text-decoration: none;
    text-align: center;
  }
  .concept-map-mobile-center {
    background: #0b1220;
    color: #7dd3fc;
    border: 2px solid #7dd3fc;
  }
  .concept-map-mobile-item:hover { opacity: 0.9; }

  @media (max-width: 640px) {
    .concept-map-wrap { display: none; }
    .concept-map-mobile { display: flex; }
  }
</style>
