---
// Base layout with nav, search, footer
const { title = 'AI Ed Wiki', description = 'AI in Education Research Wiki' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — AI Ed Wiki</title>
  <meta name="description" content={description} />
  <link rel="alternate" type="application/rss+xml" title="AI Ed Wiki RSS" href="/aied/rss.xml" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@1/css/pico.min.css" />
  <link href="/aied/pagefind/pagefind-component-ui.css" rel="stylesheet" />
  <style>
    /* Force a dark theme with a light, high-contrast accent (sky blue, not purple).
       Match Pico v1's theme-variable specificity so the override actually wins:
       Pico defines its dark vars under `[data-theme=dark]`. */
    [data-theme=dark] {
      --primary: #7dd3fc;
      --primary-hover: #bae6fd;
      --primary-focus: rgba(125, 211, 252, 0.28);
      /* Pico defaults --font-size to 16px on phones. Bump the mobile base for
         readability and to reduce browser-to-browser rendering differences. */
      --font-size: 17px;
      /* Theme the Pagefind search components to match the dark site.
         They are driven by --pf-* variables inherited from :root, and their
         own :is() selectors out-specificity a ::part override, so setting the
         variables here is the reliable way to make them dark. */
      --pf-background: #0d1418;
      --pf-text: #e8eef2;
      --pf-text-secondary: #c2ccd4;
      --pf-text-muted: #8b98a2;
      --pf-border: #2c3a45;
      --pf-border-focus: #7dd3fc;
      --pf-hover: #18232c;
      --pf-skeleton: #1c2933;
      --pf-skeleton-shine: #243440;
      --pf-mark: #ffe9a3;
      --pf-scroll-shadow: rgba(0, 0, 0, 0.5);
    }
    /* Keep a coherent light accent too, in case the theme is ever toggled. */
    :root:not([data-theme=dark]),
    [data-theme=light] {
      --primary: #0284c7;
      --primary-hover: #0369a1;
      --primary-focus: rgba(2, 132, 199, 0.15);
      --font-size: 17px;
    }
    @media (min-width: 768px) {
      [data-theme=dark] { --font-size: 18px; }
      :root:not([data-theme=dark]),
      [data-theme=light] { --font-size: 18px; }
    }
    html {
      -webkit-text-size-adjust: 100%;
      -moz-text-size-adjust: 100%;
      text-size-adjust: 100%;
    }
    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    /* Use more of the browser width on large screens */
    @media (min-width: 1200px) {
      .container { max-width: 1440px; }
    }
    header {
      background: #15212b;
      border-bottom: 1px solid var(--primary);
      padding: 0.75rem 0;
    }
    header .container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }
    .header-search {
      flex: 1;
      max-width: 30rem;
      min-width: 0;
      display: flex;
    }
    .header-search pagefind-searchbox {
      width: 100%;
    }
    .header-search pagefind-searchbox::part(input) {
      width: 100%;
      padding: 0.5rem 0.9rem;
      font-size: 0.95rem;
      border: 1px solid var(--muted-border-color);
      border-radius: 8px;
      background: #0d1418;
      color: var(--color);
    }
    .header-search pagefind-searchbox::part(input)::placeholder {
      color: var(--muted-color);
    }
    .header-search pagefind-searchbox::part(input):focus {
      border-color: var(--primary);
      outline: none;
      box-shadow: 0 0 0 3px var(--primary-focus);
    }
    header a {
      color: white;
      text-decoration: none;
    }
    header nav a {
      margin-left: 1.5rem;
      font-size: 0.95rem;
      white-space: nowrap;
    }
    /* Mobile: keep header usable on narrow screens */
    @media (max-width: 640px) {
      header .container {
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: space-between;
      }
      .header-search {
        order: 3;
        max-width: none;
        flex-basis: 100%;
      }
      header nav a { margin-left: 0.9rem; font-size: 0.9rem; }
    }
    main {
      flex: 1;
      padding-top: 2rem;
    }
    footer {
      text-align: center;
      padding: 2rem 0;
      color: var(--muted-color);
      font-size: 0.85rem;
    }
    footer .footer-nav {
      margin-bottom: 1.5rem;
    }
    footer .footer-nav a {
      color: var(--muted-color);
      text-decoration: none;
    }
    footer .footer-nav a:hover {
      color: var(--primary);
    }
    .site-footer {
      border-top: 1px solid var(--muted-border-color);
      padding-top: 1.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.85rem;
    }
    .footer-badges {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      justify-content: center;
    }
    .ai-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.2rem 0.75rem;
      border-radius: 999px;
      background: color-mix(in srgb, var(--primary) 15%, transparent);
      border: 1px solid color-mix(in srgb, var(--primary) 28%, transparent);
      color: var(--primary);
      font-size: 0.8rem;
      font-weight: 500;
    }
    .footer-text, .footer-disclaimer, .footer-contact {
      margin: 0;
      max-width: 46rem;
      line-height: 1.5;
    }
    .footer-disclaimer {
      color: var(--muted-color);
      font-size: 0.8rem;
    }
    .footer-link {
      color: var(--primary);
      text-decoration: none;
    }
    .footer-link:hover {
      text-decoration: underline;
    }
    .page-header {
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 2px solid var(--primary);
    }
    .blockquote {
      border-left: 4px solid var(--primary);
      padding: 1rem 1.5rem;
      margin: 1.5rem 0;
      background: var(--card-background-color);
      border-radius: 0 8px 8px 0;
    }
    .tag-chip {
      display: inline-block;
      padding: 0.15rem 0.6rem;
      margin: 0.15rem;
      border-radius: 12px;
      background: color-mix(in srgb, var(--primary) 18%, transparent);
      border: 1px solid color-mix(in srgb, var(--primary) 30%, transparent);
      color: var(--primary);
      font-size: 0.8rem;
      text-decoration: none;
    }
    .tag-chip:hover {
      opacity: 0.9;
      color: var(--primary);
    }
    .citation {
      margin-top: 3rem;
      padding: 1rem;
      background: var(--card-background-color);
      border-radius: 8px;
    }
    .page-item {
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--card-border-color);
    }
    .page-item:last-child {
      border-bottom: none;
    }
    .search-bar {
      margin: 1rem 0 2rem 0;
    }
    .search-bar input {
      width: 100%;
      padding: 0.75rem 1rem;
      font-size: 1.05rem;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 1rem 0;
    }
    /* Prevent wide tables from breaking mobile layout */
    @media (max-width: 768px) {
      table { display: block; overflow-x: auto; white-space: nowrap; }
    }
    th, td {
      padding: 0.5rem 0.75rem;
      border: 1px solid var(--card-border-color);
      text-align: left;
    }
    th {
      background: rgba(0,0,0,0.04);
      font-weight: 600;
    }
    tr:nth-child(even) {
      background: rgba(0,0,0,0.02);
    }
  </style>
</head>
<body>
  <header>
    <div class="container">
      <a href="/aied/" style="font-size:1.3rem;font-weight:700">🧠 AI Ed Wiki</a>
      <div class="header-search">
        <pagefind-config bundle-path="/aied/pagefind/"></pagefind-config>
        <pagefind-searchbox placeholder="Search articles & concepts..."></pagefind-searchbox>
      </div>
    </div>
  </header>
  <main class="container">
    <slot />
  </main>
  <footer>
    <div class="container">
      <div class="footer-nav">
        <a href="/aied/">Home</a> ·
        <a href="/aied/search">Search</a> ·
        <a href="/aied/journal">Journal</a> ·
        <a href="/aied/ai">Use with AI</a> ·
        <a href="https://github.com/edtechdev/aied">GitHub</a> ·
        <a href="/aied/rss.xml">RSS</a>
      </div>
    </div>
    <div class="container">
      <footer class="site-footer">
        <!-- Visual Badges -->
        <div class="footer-badges">
          <a href="https://creativecommons.org/publicdomain/zero/1.0/" target="_blank" rel="noopener noreferrer" title="CC0 1.0 Universal">
            <img src="https://licensebuttons.net/p/zero/1.0/88x31.png" alt="CC0 Public Domain" style="border: none;">
          </a>
          <span class="ai-badge">
            ✨ Generated by Hermes Agent
          </span>
        </div>

        <!-- Licensing Statement -->
        <p class="footer-text">
          This website was generated by AI (<strong>Hermes Agent</strong>) and is dedicated to the public domain under a
          <a href="https://creativecommons.org/publicdomain/zero/1.0/" class="footer-link" target="_blank" rel="noopener noreferrer">Creative Commons Zero (CC0)</a> license.
          No rights reserved.
        </p>

        <!-- Accuracy Disclaimer -->
        <p class="footer-disclaimer">
          ⚠️ Disclaimer: AI-generated output may contain inaccuracies or errors.
        </p>

        <!-- Call to Action / Contact -->
        <div class="footer-contact">
          <p style="margin: 0;">
            Found an issue with the content?<br>
            Please <a href="https://github.com/edtechdev/aied/issues" class="footer-link" target="_blank" rel="noopener noreferrer">report it on GitHub</a>, or contact the site developer, <a href="https://mastodon.social/@dougholton" class="footer-link" target="_blank" rel="noopener noreferrer">Doug Holton</a>.
          </p>
        </div>
      </footer>
    </div>
  </footer>
  <script is:inline>
    import("/aied/pagefind/pagefind-component-ui.js");
  </script>
</body>
</html>