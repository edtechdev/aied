  <script is:inline>
    // Mobile nav drawer. Any element with [data-nav-toggle]
    // (hamburger in header, backdrop overlay) opens/closes the drawer by toggling
    // data-nav-open on <html>. The drawer top tracks the header bottom.
    (() => {
      const syncDrawerTop = () => {
        const h = document.querySelector("[data-nav-header]");
        if (h) document.documentElement.style.setProperty("--drawer-top", h.getBoundingClientRect().bottom + "px");
      };
      const drawer = () => document.querySelector("[data-nav-drawer]");
      const syncInert = () => {
        const d = drawer();
        if (!d) return;
        const mobile = !window.matchMedia("(min-width: 64rem)").matches;
        const closed = !document.documentElement.hasAttribute("data-nav-open");
        d.inert = mobile && closed;
      };
      const setOpen = (open) => {
        const d = document.documentElement;
        if (open) { d.setAttribute("data-nav-open", ""); syncDrawerTop(); }
        else { d.removeAttribute("data-nav-open"); }
        d.style.overflow = open ? "hidden" : "";
        document.querySelectorAll("[data-nav-toggle]").forEach(b => b.setAttribute("aria-expanded", open ? "true" : "false"));
        syncInert();
      };
      document.addEventListener("click", (e) => {
        const t = e.target.closest("[data-nav-toggle]");
        if (!t) return;
        setOpen(!document.documentElement.hasAttribute("data-nav-open"));
      });
      window.addEventListener("resize", () => {
        if (document.documentElement.hasAttribute("data-nav-open") && window.matchMedia("(min-width: 64rem)").matches) {
          setOpen(false);
        } else {
          syncDrawerTop();
          syncInert();
        }
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setOpen(false);
      });
      syncInert();
    })();
  </script>
