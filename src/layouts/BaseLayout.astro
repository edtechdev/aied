          <details class="nav-section" open={si === 0}>
            <summary>{section.heading}</summary>
            <div class="nav-section-body">
              {section.groups.map(group => {
                const items = group.items.filter(slug => conceptMap[slug]);
                if (!items.length) return null;
                return (
                  <div class="nav-group">
                    <div class="nav-group-label">{group.label}</div>
                    <ul class="nav-list">
                      {items.map(slug => (
                        <li><a href={`/aied/concepts/${slug}`}>{conceptMap[slug]}</a></li>
                      ))}
                    </ul>
                  </div>
                );
              })}
            </div>
          </details>
        ))}
