---
// Base layout with nav, search, footer
const { title = 'AI Ed Wiki', description = 'AI in Education Research Wiki' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — AI Ed Wiki</title>
  <meta name="description" content={description} />
  <link rel="alternate" type="application/rss+xml" title="AI Ed Wiki RSS" href="/aied/rss.xml" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@1/css/pico.min.css" />
  <style>
    /* Force a dark theme with a light, high-contrast accent (sky blue, not purple).
       Match Pico v1's theme-variable specificity so the override actually wins:
       Pico defines its dark vars under `[data-theme=dark]`. */
    [data-theme=dark] {
      --primary: #7dd3fc;
      --primary-hover: #bae6fd;
      --primary-focus: rgba(125, 211, 252, 0.28);
      /* Pico defaults --font-size to 16px on phones. Bump the mobile base for
         readability and to reduce browser-to-browser rendering differences. */
      --font-size: 17px;
    }
    /* Keep a coherent light accent too, in case the theme is ever toggled. */
    :root:not([data-theme=dark]),
    [data-theme=light] {
      --primary: #0284c7;
      --primary-hover: #0369a1;
      --primary-focus: rgba(2, 132, 199, 0.15);
      --font-size: 17px;
    }
    @media (min-width: 768px) {
      [data-theme=dark] { --font-size: 18px; }
      :root:not([data-theme=dark]),
      [data-theme=light] { --font-size: 18px; }
    }
    html {
      -webkit-text-size-adjust: 100%;
      -moz-text-size-adjust: 100%;
      text-size-adjust: 100%;
    }
    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    /* Use more of the browser width on large screens */
    @media (min-width: 1200px) {
      .container { max-width: 1440px; }
    }
    header {
      background: #15212b;
      border-bottom: 1px solid var(--primary);
      padding: 1rem 0;
    }
    header .container {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    header a {
      color: white;
      text-decoration: none;
    }
    header nav a {
      margin-left: 1.5rem;
      font-size: 0.95rem;
    }
    /* Mobile: keep header nav usable on narrow screens */
    @media (max-width: 480px) {
      header .container { flex-wrap: wrap; gap: 0.25rem 0.5rem; }
      header nav a { margin-left: 0.9rem; font-size: 0.9rem; }
      .search-bar input { font-size: 1rem; }
    }
    main {
      flex: 1;
      padding-top: 2rem;
    }
    footer {
      text-align: center;
      padding: 2rem 0;
      color: var(--muted-color);
      font-size: 0.85rem;
    }
    .page-header {
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 2px solid var(--primary);
    }
    .blockquote {
      border-left: 4px solid var(--primary);
      padding: 1rem 1.5rem;
      margin: 1.5rem 0;
      background: var(--card-background-color);
      border-radius: 0 8px 8px 0;
    }
    .tag-chip {
      display: inline-block;
      padding: 0.15rem 0.6rem;
      margin: 0.15rem;
      border-radius: 12px;
      background: color-mix(in srgb, var(--primary) 18%, transparent);
      border: 1px solid color-mix(in srgb, var(--primary) 30%, transparent);
      color: var(--primary);
      font-size: 0.8rem;
      text-decoration: none;
    }
    .tag-chip:hover {
      opacity: 0.9;
      color: var(--primary);
    }
    .citation {
      margin-top: 3rem;
      padding: 1rem;
      background: var(--card-background-color);
      border-radius: 8px;
    }
    .page-item {
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--card-border-color);
    }
    .page-item:last-child {
      border-bottom: none;
    }
    .search-bar {
      margin: 1rem 0 2rem 0;
    }
    .search-bar input {
      width: 100%;
      padding: 0.75rem 1rem;
      font-size: 1.05rem;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 1rem 0;
    }
    /* Prevent wide tables from breaking mobile layout */
    @media (max-width: 768px) {
      table { display: block; overflow-x: auto; white-space: nowrap; }
    }
    th, td {
      padding: 0.5rem 0.75rem;
      border: 1px solid var(--card-border-color);
      text-align: left;
    }
    th {
      background: rgba(0,0,0,0.04);
      font-weight: 600;
    }
    tr:nth-child(even) {
      background: rgba(0,0,0,0.02);
    }
  </style>
</head>
<body>
  <header>
    <div class="container">
      <a href="/aied/" style="font-size:1.3rem;font-weight:700">🧠 AI Ed Wiki</a>
      <nav>
        <a href="/aied/">Home</a>
        <a href="/aied/journal">Journal</a>
        <a href="/aied/search">Search</a>
      </nav>
    </div>
  </header>
  <main class="container">
    <slot />
  </main>
  <footer>
    <div class="container">
      <a href="/aied/">Home</a> · 
      <a href="/aied/search">Search</a> · 
      <a href="/aied/journal">Journal</a> · 
      <a href="/aied/ai">Use with AI</a> · 
      <a href="https://github.com/edtechdev/aied">GitHub</a> ·
      <a href="https://github.com/edtechdev/aied/issues" target="_blank" rel="noopener">Report Issue</a> ·
      <a href="/aied/rss.xml">RSS</a>
    </div>
  </footer>
</body>
</html>