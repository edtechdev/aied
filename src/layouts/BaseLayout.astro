---
// Base layout with global header (search), 3-column docs layout (sidebar nav +
// right recent column), and footer. The page's own content renders in the
// middle column via <slot />, so every page gets the docs chrome automatically.
import { getCollection } from 'astro:content';
import { conceptIndex } from '../data/conceptIndex';
import TableOfContents from '../components/TableOfContents.astro';
import RecentActivity from '../components/RecentActivity.astro';
import StarredPages from '../components/StarredPages.astro';

const { title = 'AI Ed Wiki', description = 'AI in Education Wiki', hideHeaderSearch = false, toc = [] } = Astro.props;

const concepts = await getCollection('concepts');
const articles = await getCollection('articles');
const faqs = await getCollection('faqs');

// slug -> title lookup (only existing concepts render links)
const conceptMap: Record<string, string> = {};
concepts.forEach(c => { conceptMap[c.id.replace('.md', '')] = c.data.title; });

// Combined slug -> title map across concepts, articles, and FAQs, for the
// starred-pages sidebar list (so it can show friendly titles, not slugs).
const allTitles: Record<string, string> = {};
concepts.forEach(c => { allTitles[c.id.replace('.md', '')] = c.data.title; });
articles.forEach(a => { allTitles[a.id.replace('.md', '')] = a.data.title; });
faqs.forEach(f => { allTitles[f.id.replace('.md', '')] = f.data.title; });

const indexedCount = [...new Set(conceptIndex.flatMap(s => s.groups.flatMap(g => g.items)))]
  .filter(s => conceptMap[s]).length;

// Format a frontmatter timestamp (e.g. "2026-08-16T20:02:54-04:00")
// into just the date part "2026-08-16" for display.
function fmtDateTime(s: string | undefined | null): string {
  if (!s) return '';
  return s.split('T')[0];
}

// Recent articles (reverse chronological)
const recentArticles = articles
  .slice()
  .sort((a, b) => (b.data.created || '').localeCompare(a.data.created || ''))
  .slice(0, 12);

// Recently updated concepts (reverse chronological by updated, then created
// as tiebreaker so concepts updated in the same bulk commit are not listed
// alphabetically)
const recentConcepts = concepts
  .filter(c => c.data.updated || c.data.created)
  .sort((a, b) => {
    const aU = a.data.updated || a.data.created || '';
    const bU = b.data.updated || b.data.created || '';
    const cU = bU.localeCompare(aU);
    if (cU !== 0) return cU;
    // tiebreak on created (most recently created first) — non-alphabetical
    return (b.data.created || '').localeCompare(a.data.created || '');
  })
  .slice(0, 15);

// Formatted item arrays for the RecentActivity component
const recentArticleItems = recentArticles.map(a => ({
  title: a.data.title,
  url: `/aied/articles/${a.id.replace('.md', '')}`,
  date: fmtDateTime(a.data.created),
}));
const recentConceptItems = recentConcepts.map(c => ({
  title: c.data.title,
  url: `/aied/concepts/${c.id.replace('.md', '')}`,
  date: fmtDateTime(c.data.updated || c.data.created),
}));
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — AI Ed Wiki</title>
  <meta name="description" content={description} />
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/aied/logo.svg" />
  <link rel="apple-touch-icon" href="/aied/pwa-192x192.png" />
  <!-- PWA -->
  <link rel="manifest" href="/aied/manifest.webmanifest" />
  <meta name="theme-color" content="#15212b" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="AI Ed Wiki" />
  <!-- Open Graph (link previews) -->
  <meta property="og:site_name" content="AI Ed Wiki" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={"https://edtechdev.github.io/aied/"} />
  <meta property="og:image" content="https://edtechdev.github.io/aied/og-concept-map.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="1013" />
  <meta property="og:image:alt" content="Concept map of AI in Education" />
  <!-- Twitter card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://edtechdev.github.io/aied/og-concept-map.png" />
  <link rel="alternate" type="application/rss+xml" title="AI Ed Wiki RSS" href="/aied/rss.xml" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@1/css/pico.min.css" />
  <link href="/aied/pagefind/pagefind-component-ui.css" rel="stylesheet" />
  <style>
    /* Force a dark theme with a light, high-contrast accent (sky blue, not purple).
       Match Pico v1's theme-variable specificity so the override actually wins. */
    [data-theme=dark] {
      --primary: #7dd3fc;
      --primary-hover: #bae6fd;
      --primary-focus: rgba(125, 211, 252, 0.28);
      --font-size: 17px;
      /* Theme the Pagefind search components to match the dark site. */
      --pf-background: #0d1418;
      --pf-text: #e8eef2;
      --pf-text-secondary: #c2ccd4;
      --pf-text-muted: #8b98a2;
      --pf-border: #2c3a45;
      --pf-border-focus: #7dd3fc;
      --pf-hover: #18232c;
      --pf-skeleton: #1c2933;
      --pf-skeleton-shine: #243440;
      --pf-mark: #ffe9a3;
      --pf-scroll-shadow: rgba(0, 0, 0, 0.5);
    }
    :root:not([data-theme=dark]),
    [data-theme=light] {
      --primary: #0284c7;
      --primary-hover: #0369a1;
      --primary-focus: rgba(2, 132, 199, 0.15);
      --font-size: 17px;
    }
    @media (min-width: 768px) {
      [data-theme=dark] { --font-size: 18px; }
      :root:not([data-theme=dark]),
      [data-theme=light] { --font-size: 18px; }
    }
    html {
      -webkit-text-size-adjust: 100%;
      -moz-text-size-adjust: 100%;
      text-size-adjust: 100%;
    }
    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* === Header === */
    @media (min-width: 1200px) {
      .container { max-width: 1440px; }
    }
    header {
      background: #15212b;
      border-bottom: 1px solid var(--primary);
      padding: 0.75rem 0;
    }
    header .container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }
    .nav-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: color-mix(in srgb, var(--primary) 14%, transparent);
      color: #fff;
      border: 1px solid var(--primary);
      border-radius: 8px;
      width: 2.6rem;
      height: 2.6rem;
      cursor: pointer;
      flex-shrink: 0;
      padding: 0;
    }
    .nav-toggle:hover,
    .nav-toggle:focus-visible {
      background: var(--primary);
      color: #0b1220;
      border-color: var(--primary);
      outline: none;
    }
    @media (min-width: 1024px) {
      .nav-toggle { display: none; }
    }
    .header-search {
      flex: 1;
      max-width: 30rem;
      min-width: 0;
      display: flex;
    }
    .header-search pagefind-searchbox { width: 100%; }
    .header-search pagefind-searchbox::part(input) {
      width: 100%;
      padding: 0.5rem 0.9rem;
      font-size: 0.95rem;
      border: 1px solid var(--muted-border-color);
      border-radius: 8px;
      background: #0d1418;
      color: var(--color);
    }
    .header-search pagefind-searchbox::part(input)::placeholder { color: var(--muted-color); }
    .header-search pagefind-searchbox::part(input):focus {
      border-color: var(--primary);
      outline: none;
      box-shadow: 0 0 0 3px var(--primary-focus);
    }
    .header-icons {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      flex-shrink: 0;
    }
    .header-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.4rem;
      height: 2.4rem;
      padding: 0;
      color: var(--muted-color);
      border: 1px solid var(--muted-border-color);
      border-radius: 8px;
      text-decoration: none;
      background: transparent;
      transition: color 0.15s, border-color 0.15s, background 0.15s;
    }
    .header-icon:hover,
    .header-icon:focus-visible {
      color: var(--primary);
      border-color: var(--primary);
      background: color-mix(in srgb, var(--primary) 10%, transparent);
      outline: none;
    }
    header a { color: white; text-decoration: none; }
    .brand-link {
      display: inline-flex;
      align-items: center;
      font-size: 1.3rem;
      font-weight: 700;
      white-space: nowrap;
    }
    .brand-link img { flex-shrink: 0; }
    /* Mobile: keep header usable on narrow screens */
    @media (max-width: 640px) {
      header .container {
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: space-between;
      }
      .header-search {
        order: 3;
        max-width: none;
        flex-basis: 100%;
      }
    }

    main {
      flex: 1;
      padding-top: 1rem;
    }

    /* Reset Pico's default <article> spacing so content pages don't have a big
       empty gap at the top (Pico gives article a large margin/padding, and p~h1
       adds a big margin between the type badge and the page title).
       NOTE: these are :global because the <article> and .page-header are
       rendered by the page templates (their own Astro scope ids), not by
       BaseLayout — a scoped BaseLayout selector would never match them. */
    :global(article) {
      margin: 0;
      padding: 0;
      background: transparent;
      box-shadow: none;
      border-radius: 0;
    }
    :global(.page-header h1) { margin-top: 0; }

    /* === Three-column docs layout === */
    .docs-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
      align-items: start;
    }
    @media (min-width: 1024px) {
      .docs-layout { grid-template-columns: 17rem minmax(0, 1fr); }
    }
    @media (min-width: 1280px) {
      .docs-layout { grid-template-columns: 17rem minmax(0, 1fr) 19rem; }
    }

    /* === Left sidebar / mobile drawer ===
       One element serves both: on mobile (<1024px) it is a fixed off-canvas
       drawer opened by the header hamburger; on desktop it is the
       static sticky sidebar. The [data-nav-open] attribute lives on <html>. */
    .nav-backdrop {
      position: fixed;
      inset: 0;
      z-index: 30;
      display: none;
      background: rgba(0, 0, 0, 0.5);
      border: 0;
      cursor: pointer;
    }
    .sidebar {
      position: fixed;
      top: var(--drawer-top, 4rem);
      left: 0;
      z-index: 35;
      height: calc(100dvh - var(--drawer-top, 4rem));
      width: 17rem;
      max-width: 80vw;
      transform: translateX(-105%);
      transition: transform 0.25s ease;
      overflow-y: auto;
      background: var(--background-color);
      border-right: 1px solid var(--card-border-color);
      padding: 1rem 1.25rem 1.5rem 1rem;
    }
    /* The data-nav-open attribute lives on <html>, so the attribute
       selector must be :global — otherwise Astro scoping would require the same
       element to carry both the scope id and the attribute, and the rule would
       never match the drawer. */
    :global([data-nav-open]) .nav-backdrop { display: block; }
    :global([data-nav-open]) .sidebar { transform: translateX(0); }
    @media (min-width: 1024px) {
      .nav-backdrop { display: none !important; }
      .sidebar {
        position: sticky;
        top: 0;
        height: auto;
        max-height: calc(100vh - 2.5rem);
        max-width: none;
        width: auto;
        transform: none;
        transition: none;
        z-index: auto;
        background: transparent;
        border-right: 1px solid var(--card-border-color);
        padding: 0 0.5rem 0 0;
      }
    }
    .sidebar-heading {
      margin-bottom: 0.75rem;
      padding-bottom: 0.6rem;
      border-bottom: 1px solid var(--card-border-color);
    }
    .sidebar-heading a {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--color);
      text-decoration: none;
    }
    .sidebar-heading a:hover { color: var(--primary); }
    .sidebar-count {
      display: block;
      font-size: 0.78rem;
      color: var(--muted-color);
      margin-top: 0.2rem;
    }
    .nav-section {
      margin: 0 0 0.35rem 0;
      border: none;
      padding: 0;
    }
    .nav-section > summary {
      cursor: pointer;
      font-weight: 600;
      font-size: 0.9rem;
      color: var(--color);
      padding: 0.4rem 0.25rem;
      border-radius: 6px;
      list-style-position: outside;
    }
    .nav-section > summary:hover { color: var(--primary); }
    .nav-section-body { padding: 0.1rem 0 0.5rem 0.6rem; }
    .nav-group { margin-bottom: 0.6rem; }
    .nav-group-label {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--muted-color);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.25rem;
    }
    .nav-list {
      list-style: none;
      margin: 0;
      padding: 0;
      border-left: 1px solid var(--muted-border-color);
    }
    .nav-list li { margin: 0; }
    .nav-list a {
      display: block;
      font-size: 0.85rem;
      padding: 0.22rem 0.6rem;
      color: var(--muted-color);
      text-decoration: none;
      border-radius: 4px;
    }
    .nav-list a:hover {
      color: var(--primary);
      background: color-mix(in srgb, var(--primary) 8%, transparent);
    }

    /* === Middle: page content === */
    .middle {
      min-width: 0;
      max-width: 70rem;
    }

    /* === Right column: recent activity === */
    .right-col {
      padding-left: 0.5rem;
      border-left: 1px solid var(--card-border-color);
    }
    .recent-rail { margin-top: 1.75rem; }
    @media (min-width: 1024px) {
      .right-col {
        position: sticky;
        top: 0;
        max-height: calc(100vh - 2.5rem);
        display: flex;
        flex-direction: column;
      }
      /* The TOC is the pinned header (flex-shrink 0); the recent section
         scrolls in its own region below it so items never slide over the TOC. */
      .recent-rail {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
      }
    }

    /* === Footer === */
    footer {
      text-align: center;
      padding: 2rem 0;
      color: var(--muted-color);
      font-size: 0.85rem;
    }
    footer .footer-nav { margin-bottom: 1.5rem; }
    footer .footer-nav a {
      color: var(--color);
      text-decoration: none;
      font-size: 1rem;
      font-weight: 500;
    }
    footer .footer-nav a:hover { color: var(--primary); }
    .site-footer {
      border-top: 1px solid var(--muted-border-color);
      padding-top: 1.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.85rem;
    }
    .footer-badges {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex-wrap: wrap;
      justify-content: center;
    }
    .ai-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.2rem 0.75rem;
      border-radius: 999px;
      background: color-mix(in srgb, var(--primary) 15%, transparent);
      border: 1px solid color-mix(in srgb, var(--primary) 28%, transparent);
      color: var(--primary);
      font-size: 0.8rem;
      font-weight: 500;
    }
    .footer-text, .footer-disclaimer, .footer-contact {
      margin: 0;
      max-width: 46rem;
      line-height: 1.5;
      font-weight: 400;
    }
    .footer-text { color: var(--muted-color); font-size: 0.8rem; }
    .footer-text strong { font-weight: 500; }
    .footer-text .ai-sparkle { margin-right: 0.15rem; }
    .footer-disclaimer { color: var(--muted-color); font-size: 0.8rem; }
    .footer-contact { color: var(--muted-color); font-size: 0.8rem; }
    .footer-link { color: var(--primary); text-decoration: none; }
    .footer-link:hover { text-decoration: underline; }

    /* === Shared page chrome === */
    .page-header {
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 2px solid var(--primary);
    }
    .blockquote {
      border-left: 4px solid var(--primary);
      padding: 1rem 1.5rem;
      margin: 1.5rem 0;
      background: var(--card-background-color);
      border-radius: 0 8px 8px 0;
    }
    .tag-chip {
      display: inline-block;
      padding: 0.15rem 0.6rem;
      margin: 0.15rem;
      border-radius: 12px;
      background: color-mix(in srgb, var(--primary) 18%, transparent);
      border: 1px solid color-mix(in srgb, var(--primary) 30%, transparent);
      color: var(--primary);
      font-size: 0.8rem;
      text-decoration: none;
    }
    .tag-chip:hover { opacity: 0.9; color: var(--primary); }

    /* Self-linking heading anchors (rendered by the markdown templates) */
    h2[id], h3[id], #top { scroll-margin-top: 5rem; }
    .heading-anchor {
      color: var(--muted-color);
      text-decoration: none;
      margin-left: 0.15rem;
      opacity: 0;
      font-weight: 400;
      transition: opacity 0.15s ease;
    }
    h2:hover .heading-anchor, h3:hover .heading-anchor,
    .heading-anchor:focus-visible { opacity: 1; }
    .heading-anchor::before { content: '#'; }
    .heading-anchor:hover { color: var(--primary); }

    .citation {
      margin-top: 3rem;
      padding: 1rem;
      background: var(--card-background-color);
      border-radius: 8px;
    }
    .page-item {
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--card-border-color);
    }
    .page-item:last-child { border-bottom: none; }
    .search-bar { margin: 1rem 0 2rem 0; }
    .search-bar input {
      width: 100%;
      padding: 0.75rem 1rem;
      font-size: 1.05rem;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin: 1rem 0;
    }
    @media (max-width: 768px) {
      table { display: block; overflow-x: auto; white-space: nowrap; }
    }
    th, td {
      padding: 0.5rem 0.75rem;
      border: 1px solid var(--card-border-color);
      text-align: left;
    }
    th {
      background: rgba(0,0,0,0.04);
      font-weight: 600;
    }
    tr:nth-child(even) { background: rgba(0,0,0,0.02); }
  </style>
</head>
<body>
  <header data-nav-header>
    <div class="container">
      <button class="nav-toggle" data-nav-toggle type="button" aria-label="Toggle navigation" aria-expanded="false">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
      <a href="/aied/" class="brand-link">
        <img src="/aied/logo.svg" alt="AI Ed Wiki logo" width="28" height="28" style="display:inline-block;vertical-align:middle;margin-right:0.5rem;" />
        <span>AI Ed Wiki</span>
      </a>
      {!hideHeaderSearch && (
        <div class="header-search">
          <pagefind-config bundle-path="/aied/pagefind/"></pagefind-config>
          <pagefind-searchbox placeholder="Search articles, concepts, and FAQs..."></pagefind-searchbox>
        </div>
      )}
      <nav class="header-icons" aria-label="Wiki tools">
        <a href="/aied/ai" class="header-icon" title="Chat with AI" aria-label="Chat with AI">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"></path>
            <path d="M19 15l.9 2.4L22 18l-2.1.6L19 21l-.9-2.4L16 18l2.1-.6z"></path>
          </svg>
        </a>
        <a href="/aied/search" class="header-icon" title="Search" aria-label="Search">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </a>
        <a href="/aied/faq" class="header-icon" title="FAQ" aria-label="FAQ">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
        </a>
        <a href="/aied/journal" class="header-icon" title="Journal" aria-label="Journal">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M11.998 2.5A9.503 9.503 0 0 0 3.378 8H5.75a.75.75 0 0 1 0 1.5H2a1 1 0 0 1-1-1V4.75a.75.75 0 0 1 1.5 0v1.697A10.997 10.997 0 0 1 11.998 1C18.074 1 23 5.925 23 12s-4.926 11-11.002 11C6.014 23 1.146 18.223 1 12.275a.75.75 0 0 1 1.5-.037 9.5 9.5 0 0 0 9.498 9.262c5.248 0 9.502-4.253 9.502-9.5s-4.254-9.5-9.502-9.5Z"></path>
            <path d="M12.5 7.25a.75.75 0 0 0-1.5 0v5.5c0 .27.144.518.378.651l3.5 2a.75.75 0 0 0 .744-1.302L12.5 12.315V7.25Z"></path>
          </svg>
        </a>
