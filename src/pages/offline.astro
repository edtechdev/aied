---
// Standalone offline fallback. Deliberately does NOT use BaseLayout: it must
// load from the service-worker precache with no external CSS, fonts, images,
// scripts, or Pagefind requests. One English fallback is enough for the first
// implementation; the address bar keeps the original (possibly localized) URL.
const base = '/aied';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Page not available offline — AI in Education Knowledge Base</title>
    <style>
      :root { color-scheme: dark light; }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 1.5rem;
        background: #0d1418;
        color: #e8eef2;
        font: 16px/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      }
      main { max-width: 34rem; }
      h1 { font-size: 1.5rem; line-height: 1.25; margin: 0 0 0.75rem; }
      p { margin: 0 0 0.9rem; color: #b7c3cb; }
      .actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.4rem; }
      button, a.button {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 0.55rem 1rem;
        border: 2px solid #3a4a56;
        border-radius: 6px;
        background: transparent;
        color: #e8eef2;
        font: inherit;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
      }
      button:hover, a.button:hover, button:focus-visible, a.button:focus-visible {
        border-color: #6fb3d2;
        outline: 2px solid #6fb3d2;
        outline-offset: 2px;
      }
      button { background: #1d2d38; }
    </style>
  </head>
  <body data-pagefind-ignore>
    <main>
      <h1>This page is not available offline.</h1>
      <p>
        We could not connect, and this page is not saved on this device. Reconnect and try again.
        Some pages you previously opened may still be available.
      </p>
      <div class="actions">
        <button id="retry" type="button">Retry</button>
        <a class="button" href={`${base}/`}>Home</a>
      </div>
    </main>
    <script is:inline>
      document.getElementById('retry')?.addEventListener('click', () => location.reload());
    </script>
  </body>
</html>
