---
// Localized resources index: one route per locale in site.config.json
// (`i18n.locales`) other than the default, which keeps the unprefixed URL.
// Copy comes from src/i18n/pages/resources.<locale>.ts.
import { NON_DEFAULT_LOCALES } from '../../../i18n/config';
import ResourcesPage from '../../../components/pages/ResourcesPage.astro';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<ResourcesPage locale={locale!} />