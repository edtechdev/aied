---
// Translated FAQ page, e.g. /aied/fr/faqs/designing-ai-into-learning/.
// The file lives at fr/faqs/designing-ai-into-learning.md and declares
// `translation_of: faqs/designing-ai-into-learning`.
import { getCollection } from 'astro:content';
import TranslatedPage from '../../../components/pages/TranslatedPage.astro';

export async function getStaticPaths() {
  const translations = await getCollection('translations');
  return translations
    .filter((e) => e.id.split('/')[1] === 'faqs')
    .map((e) => ({
      params: { locale: e.id.split('/')[0], slug: e.id.split('/')[2].replace(/\.md$/, '') },
      props: { entry: e },
    }));
}

const { locale } = Astro.params;
const { entry } = Astro.props;
---

<TranslatedPage entry={entry} locale={locale} pageType="faqs" />