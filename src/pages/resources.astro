---
// The /resources index: a standalone, hand-written page (like /faq) that introduces
// what these resources are and lists every one, grouped by the kind of thing it is.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageTypeIcon from '../components/PageTypeIcon.astro';

const resources = await getCollection('resources');
const titleCase = (s: string) => s.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

// Grouped by the FIRST declared resource_type, so one tool that is both software and
// a collection lands in a single place instead of being listed twice.
const GROUP_ORDER = [
  'software',
  'ai tutor',
  'agent skill',
  'prompt or gem library',
  'collection of tools',
  'collection of activities',
  'assessment instrument',
  'open format or specification',
  'ebook or guide',
  'case study collection',
  'dataset or benchmark',
];
const groups = GROUP_ORDER.map((type) => ({
  type,
  items: resources
    .filter((r) => (r.data.resource_type || [])[0] === type)
    .sort((a, b) => a.data.title.localeCompare(b.data.title)),
})).filter((g) => g.items.length > 0);

// One on-this-page TOC entry per tool type, so the right rail lists the kinds of
// thing on the page (Software, AI Tutor, ...) and the sticky aside can jump to
// them. The id goes on the group's <h2>, which is what BaseLayout's
// scroll-margin-top rule and the TOC's scrollspy expect.
const anchor = (s: string) => s.replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const toc = groups.map((g) => ({ text: titleCase(g.type), slug: anchor(g.type), depth: 2 }));
---

<BaseLayout title="Resources" toc={toc}>
  <h1><PageTypeIcon kind="resource" size={20} />Free Tools and Resources</h1>

  <div style="line-height:1.7;color:var(--color);margin-bottom:1.5rem;">
    <p style="margin-bottom:0.75rem;">
      A curated set of <strong>free tools, collections, instruments and formats</strong> for AI in
      education — things you can go and use today rather than research you have to read first. They
      are made mostly by educators, instructional designers, librarians and researchers, and many
      were built with AI assistance by people who are not professional developers.
    </p>
    <p style="margin-bottom:0.75rem;">
      Not everything here is interactive. Alongside browser tools and AI tutors you will find
      libraries of ready-made prompts and "gems", collections of classroom activities, briefing and
      policy documents, assessment instruments, and open file formats. Each entry is a short summary
      that links to a page saying who made it, what kind of thing it is, whether the source code is
      available, what it costs to use, and when its link was last checked.
    </p>
    <p>
      Every entry links out to an external site that this knowledge base does not control, and the
      links are re-checked periodically — each page shows the date its link was last confirmed. If
      a tool has moved, gone closed, or deserves to be here and is missing, the fastest route is to
      open an issue on the repository.
    </p>
  </div>

  {resources.length === 0 && <p>No resources yet.</p>}

  {groups.map((group) => (
    <section style="margin-bottom:2rem;">
      <h2 id={anchor(group.type)} style="font-size:1.15rem;">{titleCase(group.type)}</h2>
      <ul class="connected-list">
        {group.items.map((r) => {
          const href = `/aied/resources/${r.id.replace('.md', '')}/`;
          return (
            <li>
              <a href={href}><PageTypeIcon kind="resource" />{r.data.title}</a>
              {r.data.summary && <div class="connected-summary">{r.data.summary}</div>}
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</BaseLayout>

<style>
  /* Each entry reuses the foot-of-page connected-list look (page-type icon, title,
     summary in muted smaller text) instead of the old bordered card, which drops
     the card padding and border. The list styling itself is global, in BaseLayout. */
  .connected-list {
    margin-top: 0.5rem;
  }
</style>
