---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceButtons from '../../components/SourceButtons.astro';
import JsonLd from '../../components/JsonLd.astro';
import MetadataTable from '../../components/MetadataTable.astro';
import StarButton from '../../components/StarButton.astro';
import { renderMarkdown, smartTitle } from '../../lib/markdown';

export async function getStaticPaths() {
  const faqs = await getCollection('faqs');
  return faqs.map(f => ({ params: { slug: f.id.replace('.md', '') } }));
}

const { slug } = Astro.params;
const faqs = await getCollection('faqs');
// Tag chips use the page's own title ("Well-Being", not "well being"); long titles
// are skipped so a chip stays short.
const tagLabel = (tag: string): string => {
  const t = allTitles[tag];
  return t && t.length <= 28 ? t : smartTitle(tag.replace(/-/g, ' '));
};

const faq = faqs.find(f => f.id.replace('.md', '') === slug);
if (!faq) return Astro.redirect('/aied/');

const allArticles = await getCollection('articles');


const allConcepts = await getCollection('concepts');
const conceptTitles: Record<string, string> = Object.fromEntries(
  allConcepts.map((c) => [c.id.replace('.md', ''), c.data.title]),
);

// Tag chips show the concept's own title ("Well-Being", not "well being");
// de-slugify only as a fallback, and skip long titles to keep chips short.


// Slugs for canonical wikilink routing: article -> /articles, concept -> /concepts, faq -> /faqs
const articleSlugs = new Set(allArticles.map(a => a.id.replace('.md', '')));
const conceptSlugs = new Set(allConcepts.map(c => c.id.replace('.md', '')));
const faqSlugs = new Set(faqs.map(f => f.id.replace('.md', '')));

const { title, created, updated, research_method, discipline, audience, level, page_kind, foundations, pedagogy, technology, assessment, stakeholders, ethics } = faq.data;
// JSON-LD keywords: the typed fields, which replaced the old per-page tag list.
const metadataKeywords: string[] = [...(research_method || []), ...(discipline || []), ...(level || []), ...(audience || []), ...(foundations || []), ...(pedagogy || []), ...(technology || []), ...(assessment || []), ...(stakeholders || []), ...(ethics || []), ...(page_kind || []),];
// Build PageFind filter facets from the structured metadata fields.
// Emit one <meta> per name:value pair (PageFind parses only the LAST inline
// filter in a comma-joined list, so each facet must be its own element).
const metaFields: { name: string; values: string[] | undefined }[] = [
  { name: 'foundations', values: foundations },
  { name: 'pedagogy', values: pedagogy },
  { name: 'technology', values: technology },
  { name: 'assessment', values: assessment },
  { name: 'stakeholders', values: stakeholders },
  { name: 'ethics', values: ethics },
  { name: 'level', values: level },
  { name: 'audience', values: audience },
  { name: 'discipline', values: discipline },
  { name: 'page_kind', values: page_kind },
  { name: 'research_method', values: research_method },
];
const pagefindFilterPairs: string[] = metaFields
  .flatMap(({ name, values }) => (values || []).map((v) => `${name}:${v}`));
const createdDisplay = (created || '').split('T')[0];
const updatedDisplay = (updated || created || '').split('T')[0];
const body = faq.body || '';

// slug -> display title for every page: wikilink labels and tag chips use the page's
// own title ('Well-Being'), not a de-slugified guess ('well being').
const allTitles: Record<string, string> = {};
[...allConcepts, ...allArticles, ...faqs].forEach(c => { allTitles[c.id.replace('.md', '')] = c.data.title; });

const rendered = renderMarkdown(body, { pageTitle: title, articleSlugs, conceptSlugs, faqSlugs, titles: allTitles });
const toc = rendered.headings.filter(h => h.depth <= 3);
---

<BaseLayout title={title} toc={toc}>
  <JsonLd
    type="faq"
    slug={slug}
    title={title}
    created={created}
    updated={updated}
    keywords={metadataKeywords}
    body={body}
  />
  <article data-pagefind-filter="page_type:faq">
    {pagefindFilterPairs.map((pair) => <meta data-pagefind-filter={pair} />)}
    <div class="page-header" id="top">
      <p class="page-type-badge" style="font-size:0.8rem;color:var(--muted-color);margin-bottom:0.25rem;"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline-block;vertical-align:-0.15em;margin-right:0.3rem;"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>FAQ</p>
      <h1>{title}</h1>
      <div class="page-meta" style="color:var(--muted-color);font-size:0.9rem;margin-bottom:0.75rem;">
        <StarButton slug={slug} kind="faq" />
        created {createdDisplay}{updated ? ` · updated ${updatedDisplay}` : ''}
      </div>
    </div>

    <div style="line-height:1.8" data-pagefind-body>
      <Fragment set:html={rendered.html} />
    </div>

    <MetadataTable conceptTitles={conceptTitles} data={faq.data} />
    <SourceButtons filePath={`faqs/${faq.id}.md`} />
  </article>
</BaseLayout>
