---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const concepts = await getCollection('concepts');
  // Collect all valid slugs
  const slugs = new Set<string>();
  articles.forEach(a => slugs.add(a.id.replace('.md', '')));
  concepts.forEach(c => slugs.add(c.id.replace('.md', '')));
  return [...slugs].map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const articles = await getCollection('articles');
const concepts = await getCollection('concepts');

// Check which collection this slug belongs to
const isArticle = articles.some(a => a.id.replace('.md', '') === slug);
const isConcept = concepts.some(c => c.id.replace('.md', '') === slug);

if (isArticle) {
  return Astro.redirect(`/aied/articles/${slug}/`, 301);
}
if (isConcept) {
  return Astro.redirect(`/aied/concepts/${slug}/`, 301);
}
return Astro.redirect('/aied/', 301);
---

<!-- This page redirects to the correct collection URL -->