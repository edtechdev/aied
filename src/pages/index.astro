---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ConceptMap from '../components/ConceptMap.astro';
import siteConfig from '../config/siteConfig';

const articles = await getCollection('articles');
const concepts = await getCollection('concepts');
const faqs = await getCollection('faqs');

const toc = [
  { text: 'Start here', slug: 'start-here', depth: 2 },
  { text: 'Short on time', slug: 'short-on-time', depth: 2 },
  { text: 'What is inside', slug: 'what-is-inside', depth: 2 },
  { text: 'Bring your own assistant', slug: 'bring-your-own-assistant', depth: 2 },
];

// === RSS ===
import rss from '@astrojs/rss';
export const GET = () => {
  const items = articles
    .filter(a => (a.data.sources || []).length > 0)
    .sort((a, b) => b.data.created.localeCompare(a.data.created))
    .slice(0, 40)
    .map(a => ({
      title: a.data.title,
      link: `/aied/articles/${a.id.replace('.md', '')}/`,
      pubDate: new Date(a.data.created),
      description: a.body?.split('\n').slice(0, 5).join(' ')?.slice(0, 400) || '',
    }));
  return rss({
    title: siteConfig.name,
    description: 'AI in Education Research',
    site: siteConfig.url.replace(/\/aied$/, ''),
    items,
    stylesheet: '/aied/rss.xsl',
  } as any);
};
---

<BaseLayout title="Home" toc={toc}>
  <h1 class="page-title">{siteConfig.name}</h1>
  <ConceptMap />

  <p class="intro-paragraph">
    A living, open knowledge base on <a href="/aied/concepts/ai-education/">artificial intelligence in education</a>, distilling recent open-access research into short, structured pages you can read and act on. It holds <strong>{articles.length} article summaries</strong>, <strong>{concepts.length} concept pages</strong>, and <strong><a href="/aied/faq">{faqs.length} FAQs</a></strong>, and it is written and maintained by an AI agent that names the paper behind every claim.
  </p>

  <h2 id="start-here">Start here</h2>
  <ul class="home-list">
    <li>
      <strong>Instructors and teaching staff</strong> — begin with <a href="/aied/concepts/ai-literacy/">AI literacy</a>, <a href="/aied/concepts/learning-design/">learning design</a>, <a href="/aied/concepts/feedback/">feedback</a>, and <a href="/aied/concepts/teacher-role/">the changing teaching role</a>, then check <a href="/aied/concepts/academic-integrity/">academic integrity</a>, <a href="/aied/concepts/reducing-ai-misuse/">reducing AI misuse</a>, and <a href="/aied/concepts/misconceptions/">misconceptions about AI</a> for the problems students actually bring to class.
    </li>
    <li>
      <strong>Administrators and leaders</strong> — <a href="/aied/concepts/administrator/">the administrator role</a>, <a href="/aied/concepts/governance/">AI governance</a>, <a href="/aied/concepts/educational-policy-ai/">institutional policy</a>, and <a href="/aied/concepts/change-management/">change management</a> cover the decisions that outlast any single tool.
    </li>
    <li>
      <strong>Researchers</strong> — <a href="/aied/concepts/research-methods-aied/">research methods in AIED</a>, <a href="/aied/concepts/interpreting-and-applying-aied-research/">how to read a single study</a>, and the <a href="/aied/concepts/limitations-in-aied-research/">cross-cutting limits of this evidence base</a>.
    </li>
    <li>
      <strong>Designers and developers</strong> — <a href="/aied/concepts/educational-technology-developers/">building for education</a>, <a href="/aied/concepts/ai-technologies/">the technologies underneath</a>, and <a href="/aied/concepts/agentic-ai/">agentic AI</a> for systems that act rather than answer.
    </li>
  </ul>

  <h2 id="short-on-time">Short on time</h2>
  <ul class="home-list">
    <li><a href="/aied/faqs/top-10-findings-ai-education-instructors/">Ten findings instructors can use</a> — the most actionable evidence here, on one page.</li>
    <li><a href="/aied/concepts/ai-education/">AI in Education</a> — the field's overview page and the map to every strand.</li>
    <li><a href="/aied/faq">The FAQ index</a> — the questions people ask first, each pointing at the pages that answer it.</li>
    <li><a href="/aied/journal">The journal</a> — what was added most recently, with an <a href="/aied/rss.xml">RSS feed</a> if you want to follow along.</li>
  </ul>

  <h2 id="what-is-inside">What is inside</h2>
  <p class="intro-paragraph">
    The concept map above shows what connects to what. For the hierarchy behind it, <a href="/aied/concepts/ai-education/#how-the-knowledge-base-is-organized-the-umbrella-pages">AI in Education</a> is the map page: it groups the concepts into roughly a dozen umbrella strands — literacy, pedagogy, technologies, disciplines, assessment, feedback, research methods, governance — and each strand names its own concepts and the papers behind them. Browse the strand-by-strand index in the left sidebar, or <a href="/aied/search">search</a> the whole knowledge base. Each article page condenses one paper into its purpose, methods, and findings, with a full citation and links to related work. Reading offline? Take the <a href="/aied/aied.epub">EPUB</a> or the <a href="/aied/aied.pdf">PDF</a>.
  </p>

  <h2 id="bring-your-own-assistant">Bring your own assistant</h2>
  <p class="intro-paragraph">
    The same pages are published as machine-readable files, so you can point ChatGPT, Claude, or another assistant at this knowledge base and get answers that cite it instead of guessing. <a href="/aied/ai">Copy-paste prompts are here</a>.
  </p>
</BaseLayout>

<style>
  .page-title {
    margin: 0 0 1.25rem 0;
    font-size: 1.6rem;
  }
  .intro-paragraph {
    color: var(--muted-color);
    margin-bottom: 1.25rem;
    font-size: 1.02rem;
    line-height: 1.7;
  }
  h2 {
    margin: 1.9rem 0 0.9rem 0;
    font-size: 1.2rem;
  }
  .home-list {
    list-style: none;
    padding-left: 0;
    margin: 0 0 1.2rem 0;
  }
  .home-list li {
    margin-bottom: 0.8rem;
    line-height: 1.65;
    font-size: 1.02rem;
    color: var(--muted-color);
  }
  .home-list strong {
    color: var(--color);
  }
  .home-list a,
  .intro-paragraph a {
    font-weight: 500;
  }
</style>
