    background: color-mix(in srgb, var(--primary) 5%, transparent);
  }
  .map-title {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
  }
  .map-caption {
    margin: 0 0 1rem;
    font-size: 0.92rem;
    color: var(--muted-color);
    line-height: 1.6;
  }
  .map-diagram {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: 8px;
    background: var(--card-background-color, var(--background-color));
    padding: 0.75rem;
  }
  .map-diagram pre.mermaid {
    margin: 0;
    font-size: 0.95rem;
    text-align: center;
  }
  .map-diagram pre.mermaid svg {
    max-width: 100%;
    height: auto;
  }
</style>
