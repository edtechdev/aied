---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = await getCollection('articles');
const concepts = await getCollection('concepts');

// === Articles: recently added ===
const articlesByDate: Record<string, typeof articles> = {};
articles.forEach(a => {
  const d = a.data.created.split('T')[0];
  (articlesByDate[d] ||= []).push(a);
});
const articleDates = Object.keys(articlesByDate).sort().reverse().slice(0, 10);

// === Concepts: recently updated ===
const conceptsSorted = concepts
  .filter(c => c.data.updated || c.data.created)
  .sort((a, b) => {
    const aDate = a.data.updated || a.data.created;
    const bDate = b.data.updated || b.data.created;
    return bDate.localeCompare(aDate);
  })
  .slice(0, 15);

// === Tag cloud from articles ===
const tagCounts: Record<string, number> = {};
articles.forEach(a => {
  (a.data.tags || []).forEach(tag => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});
const topTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 40);

// === RSS ===
import rss from '@astrojs/rss';
export const GET = () => {
  const items = articles
    .filter(a => (a.data.sources || []).length > 0)
    .sort((a, b) => b.data.created.localeCompare(a.data.created))
    .slice(0, 40)
    .map(a => ({
      title: a.data.title,
      link: `/aied/articles/${a.id.replace('.md', '')}`,
      pubDate: new Date(a.data.created),
      description: a.body?.split('\n').slice(0, 5).join(' ')?.slice(0, 400) || '',
    }));
  return rss({
    title: 'AI Ed Wiki',
    description: 'AI in Education Research',
    site: 'https://edtechdev.github.io',
    items,
    stylesheet: '/aied/rss.xsl',
  } as any);
};
---

<BaseLayout title="Home">
  <div class="search-bar">
    <pagefind-config bundle-path="/aied/pagefind/"></pagefind-config>
    <pagefind-searchbox placeholder={`Search ${articles.length + concepts.length} articles & concepts...`}></pagefind-searchbox>
  </div>

  <!-- === Recently Added Articles === -->
  <section style="margin-bottom:2.5rem;">
    <h2>📄 Recently Added Articles <span style="font-size:0.8rem;color:var(--muted-color);font-weight:normal;">({articles.length} total)</span></h2>
    {articleDates.slice(0, 7).map(date => (
      <details class="journal-day" open={date === articleDates[0]} style="margin-bottom:0.75rem;border:1px solid var(--card-border-color);border-radius:8px;padding:0.75rem 1rem;">
        <summary style="cursor:pointer;font-weight:bold;color:var(--primary);">
          {date} — {articlesByDate[date].length} new article{articlesByDate[date].length !== 1 ? 's' : ''}
        </summary>
        {articlesByDate[date].map(a => (
          <div class="journal-entry" style="padding:0.4rem 0 0.4rem 1.2rem;border-left:2px solid var(--primary);margin:0.3rem 0;">
            <a href={`/aied/articles/${a.id.replace('.md', '')}`} style="font-weight:500;">
              {a.data.title}
            </a>
            <div style="font-size:0.72rem;color:var(--muted-color);margin-top:0.2rem;">
              {(a.data.tags || []).slice(0, 6).map((tag, i) => (
                <>{i > 0 ? ', ' : ''}<a href={`/aied/tags/${tag}`} class="tag-chip" style="font-size:0.68rem;padding:0.05rem 0.4rem;">{tag}</a></>
              ))}
            </div>
          </div>
        ))}
      </details>
    ))}
    <p style="margin-top:0.5rem;"><a href="/aied/journal">View all articles →</a></p>
  </section>

  <hr style="margin:2rem 0" />

  <!-- === Recently Updated Concepts === -->
  <section style="margin-bottom:2.5rem;">
    <h2>🏷️ Recently Updated Concepts <span style="font-size:0.8rem;color:var(--muted-color);font-weight:normal;">({concepts.length} total)</span></h2>
    <div>
          {conceptsSorted.map(c => (
            <div class="page-item">
              <a href={`/aied/concepts/${c.id.replace('.md', '')}`} style="font-weight:500;">
                {c.data.title}
              </a>
            </div>
          ))}
        </div>
  </section>

  <hr style="margin:2rem 0" />

  <!-- === Popular Tags === -->
  <section>
    <h2>🔖 Popular Tags</h2>
    <div style="line-height:2.2;margin-bottom:1rem;">
      {topTags.map(([tag, count]) => {
        const size = 0.75 + (count / Math.max(...topTags.map(t => t[1]))) * 1.3;
        return (
          <a href={`/aied/tags/${tag}`} class="tag-chip" style={`font-size:${size.toFixed(2)}rem`}>
            {tag} ({count})
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>

<link href="/aied/pagefind/pagefind-component-ui.css" rel="stylesheet" />
<script is:inline>
  import("/aied/pagefind/pagefind-component-ui.js");
</script>

<style>
  pagefind-searchbox::part(input) {
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: 1.05rem;
    border: 2px solid var(--card-border-color);
    border-radius: 6px;
    background: var(--card-background-color);
  }
  pagefind-searchbox::part(input):focus {
    border-color: var(--primary);
    outline: none;
  }
</style>