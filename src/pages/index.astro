---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = await getCollection('articles');

// === RSS ===
import rss from '@astrojs/rss';
export const GET = () => {
  const items = articles
    .filter(a => (a.data.sources || []).length > 0)
    .sort((a, b) => b.data.created.localeCompare(a.data.created))
    .slice(0, 40)
    .map(a => ({
      title: a.data.title,
      link: `/aied/articles/${a.id.replace('.md', '')}`,
      pubDate: new Date(a.data.created),
      description: a.body?.split('\n').slice(0, 5).join(' ')?.slice(0, 400) || '',
    }));
  return rss({
    title: 'AI Ed Wiki',
    description: 'AI in Education Research',
    site: 'https://edtechdev.github.io',
    items,
    stylesheet: '/aied/rss.xsl',
  } as any);
};
---

<BaseLayout title="Home">
  <h1 class="page-title">AI in Education Research Wiki</h1>
  <p class="intro-paragraph">
    Welcome to the <strong>AI in Education Research Wiki</strong> — a living, machine-and-human-readable knowledge base of recent research on artificial intelligence in education. This site continuously <strong>ingests open-access research articles</strong> related to AI in education (from arXiv, EdArXiv, and peer-reviewed journals), summarizes each paper, and <strong>connects the articles through concept pages</strong> — shared concepts such as AI tutoring, assessment, AI literacy, equity, and feedback — so that related work is easy to discover. The site is <strong>generated by the Hermes AI agent</strong> and is updated regularly as new open-access research is published.
  </p>
  <p class="intro-paragraph">
    <strong>How to use this site:</strong> browse the hierarchical concept index in the left sidebar to explore themes, open any article page for a structured summary and its APA citation, or use the search box in the header. Because the full catalog and content are published as machine-readable files, you can also point your own AI assistant at this knowledge base — see <a href="/aied/ai" style="font-weight:500;">Use This Wiki with Your Own AI Assistant</a> for copy-paste prompts that let you explore AI in education research and educational AI applications with the wiki as your research reference.
  </p>
  <p class="intro-paragraph">
    <strong>AI in Education (AIED)</strong> is the broad, interdisciplinary field that applies artificial intelligence to teaching and learning, and studies its design, use, evaluation, and consequences. It spans <strong>AI for education</strong> — using AI to improve instruction, assessment, and administration — and <strong>education about AI</strong> — building the AI literacy and critical understanding learners and educators need. Start with the <a href="/aied/concepts/ai-education" style="font-weight:500;">AI in Education</a> overview page, then explore the concept strands in the sidebar.
  </p>
  <p class="intro-paragraph">
    Some essential concepts in this wiki include: <a href="/aied/concepts/ai-literacy" style="font-weight:500;">AI Literacy</a>, <a href="/aied/concepts/student-misconceptions-ai" style="font-weight:500;">Misconceptions about AI</a>, <a href="/aied/concepts/reducing-ai-misuse" style="font-weight:500;">Reducing AI Misuse</a>, <a href="/aied/concepts/agentic-ai" style="font-weight:500;">Agentic AI</a>, <a href="/aied/concepts/intelligent-tutoring" style="font-weight:500;">Intelligent Tutoring</a>, <a href="/aied/concepts/over-reliance" style="font-weight:500;">Over-reliance on AI</a>, <a href="/aied/concepts/instructional-design" style="font-weight:500;">Instructional Design</a>, <a href="/aied/concepts/faculty-development" style="font-weight:500;">Faculty Development</a>, <a href="/aied/concepts/academic-integrity" style="font-weight:500;">Academic Integrity</a>, <a href="/aied/concepts/research-methods-aied" style="font-weight:500;">Research Methods</a>, and <a href="/aied/concepts/ai-ed-evaluation" style="font-weight:500;">AI Ed Evaluation</a>.
  </p>

  <div class="middle-note">
    <strong>Browse by strand:</strong> each section in the left sidebar groups related concepts. Open a section, then click a concept for its overview, related articles, and connected concepts.
  </div>
</BaseLayout>

<style>
  .page-title {
    margin: 0 0 1.25rem 0;
    font-size: 1.6rem;
  }
  .intro-paragraph {
    color: var(--muted-color);
    margin-bottom: 1.25rem;
    font-size: 1.02rem;
    line-height: 1.7;
  }
  .middle-note {
    margin-top: 1.75rem;
    padding: 0.9rem 1.1rem;
    background: color-mix(in srgb, var(--primary) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--primary) 22%, transparent);
    border-left: 4px solid var(--primary);
    border-radius: 0 8px 8px 0;
    font-size: 0.92rem;
    color: var(--color);
  }
</style>
