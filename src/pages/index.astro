---
// English home page (default locale, no URL prefix). The localized routes live in
// src/pages/[locale]/index.astro; the copy comes from src/i18n/pages/home.<locale>.ts.
import { getCollection } from 'astro:content';
import HomePage from '../components/pages/HomePage.astro';
import siteConfig from '../config/siteConfig';

const articles = await getCollection('articles');

// === RSS ===
import rss from '@astrojs/rss';
export const GET = () => {
  const items = articles
    .filter(a => (a.data.sources || []).length > 0)
    .sort((a, b) => b.data.created.localeCompare(a.data.created))
    .slice(0, 40)
    .map(a => ({
      title: a.data.title,
      link: `/aied/articles/${a.id.replace('.md', '')}/`,
      pubDate: new Date(a.data.created),
      description: a.body?.split('\n').slice(0, 5).join(' ')?.slice(0, 400) || '',
    }));
  return rss({
    title: siteConfig.name,
    description: 'AI in Education Research',
    site: siteConfig.url.replace(/\/aied$/, ''),
    items,
    stylesheet: '/aied/rss.xsl',
  } as any);
};

---

<HomePage locale="en" />
