---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = await getCollection('articles');
const concepts = await getCollection('concepts');

// === Concept lookup: slug -> {title, exists} ===
const conceptMap: Record<string, string> = {};
concepts.forEach(c => { conceptMap[c.id.replace('.md', '')] = c.data.title; });

// === AI in Education Concepts: hierarchical index ===
// Modeled on the ai-education concept page. Every concept appears exactly once.
// Links only render for slugs that actually exist, so coverage is safe if a
// concept is renamed/removed.
const conceptIndex: { heading: string; blurb?: string; groups: { label: string; items: string[] }[] }[] = [
  {
    heading: 'Learning and instruction',
    blurb: 'How AI supports teaching and learning is the heart of the field — from core pedagogies to learning theories, AI agents, and subject areas.',
    groups: [
      { label: 'Core pedagogies', items: ['active-learning', 'collaborative-learning', 'project-based-learning', 'experiential-learning', 'game-based-learning', 'gamification', 'scaffolding', 'socratic-method', 'self-regulated-learning', 'self-determination-theory', 'zone-of-proximal-development', 'desirable-difficulties', 'transfer-of-learning', 'metacognition', 'cognitive-load-theory', 'dual-process-theory', 'constructivist', 'embodied-learning', 'storytelling-in-education', 'instructional-design'] },
      { label: 'Learning theories and processes', items: ['motivation', 'self-efficacy', 'help-seeking', 'student-engagement', 'engagement-metrics', 'feedback-loop', 'cognitive-diagnosis', 'student-modeling', 'knowledge-tracing', 'student-misconceptions-ai', 'simulating-students', 'icap-framework'] },
      { label: 'AI agents and interactions', items: ['ai-tutoring', 'intelligent-tutoring', 'pedagogical-agent', 'affective-tutoring', 'affective-computing', 'human-in-the-loop-ai', 'pedagogical-llm-training', 'social-robots', 'educational-robotics', 'human-robot-interaction'] },
      { label: 'Subject areas', items: ['math-education', 'physics-education', 'language-learning', 'cs-education', 'programming-education', 'writing-education', 'stem-education', 'k-12-ai-education', 'special-education', 'adult-learning', 'higher-ed', 'block-programming'] },
    ],
  },
  {
    heading: 'Assessment, evaluation, and measurement',
    blurb: 'AI transforms both how we assess learners and how we evaluate AI systems themselves.',
    groups: [
      { label: 'Assessment', items: ['assessment', 'formative-assessment', 'authentic-assessment', 'automated-assessment', 'automated-grading', 'automated-essay-scoring', 'automated-question-generation', 'assessment-validity', 'confidence-aware-ai-assessment', 'psychometrically-aware-ai', 'educational-measurement', 'item-response-theory', 'plagiarism-detection', 'academic-integrity', 'ai-feedback-quality', 'peer-review'] },
      { label: 'Evaluation of AI systems', items: ['ai-ed-evaluation', 'benchmark', 'research-methods-aied', 'rct', 'learning-gains', 'meta-analysis-systematic-review'] },
    ],
  },
  {
    heading: 'AI systems and techniques',
    blurb: 'The AI models and methods that power education technology, from generative models to knowledge representation.',
    groups: [
      { label: 'Models and techniques', items: ['generative-ai', 'llm', 'rag', 'multimodal', 'reinforcement-learning', 'educational-nlp', 'knowledge-graph', 'simulation', 'adaptive-prompt-routing', 'adaptive-learning', 'personalized-learning'] },
    ],
  },
  {
    heading: 'People: learners, teachers, and institutions',
    blurb: 'AI changes the role of every stakeholder in education.',
    groups: [
      { label: 'Learners', items: ['student-experience', 'well-being', 'social-emotional-learning', 'agency', 'creativity'] },
      { label: 'Teachers', items: ['teacher-role', 'teacher-ai-competency', 'faculty-development', 'pedagogical-safety'] },
      { label: 'Institutions and systems', items: ['administrator', 'educational-policy-ai', 'ai-governance-education', 'governance', 'regulation', 'privacy', 'open-source', 'edtech-platform', 'learning-analytics', 'lifelong-learning', 'professional-training', 'k-12'] },
    ],
  },
  {
    heading: 'Equity, ethics, and responsible use',
    blurb: 'Fairness, access, and responsibility are central to AI in education.',
    groups: [
      { label: 'Equity and access', items: ['equity-in-ai-education', 'digital-divide', 'bias-mitigation', 'culturally-relevant-pedagogy', 'accessible-learning', 'neurodiversity', 'universal-design-for-learning'] },
      { label: 'Ethics and responsibility', items: ['ethics', 'ai-misuse-learning-harm', 'hallucination-risk', 'trust', 'trust-calibration', 'reducing-ai-misuse', 'over-reliance', 'cognitive-offloading', 'critical-thinking'] },
    ],
  },
  {
    heading: 'Emergent and cross-cutting themes',
    blurb: 'Concepts that span the field, from AI literacy to human–AI collaboration and design approaches.',
    groups: [
      { label: 'Cross-cutting', items: ['ai-literacy', 'prompt-engineering', 'human-ai-collaboration', 'agentic-ai', 'computational-thinking', 'design-thinking', 'curriculum-design'] },
    ],
  },
];

// Flatten for coverage count (deduped)
const indexedSlugs = [...new Set(conceptIndex.flatMap(s => s.groups.flatMap(g => g.items)))];
const indexedCount = indexedSlugs.filter(s => conceptMap[s]).length;

// === Articles: recent (reverse chronological) ===
const recentArticles = articles
  .slice()
  .sort((a, b) => (b.data.created || '').localeCompare(a.data.created || ''))
  .slice(0, 12);

// === Concepts: recently updated ===
const conceptsSorted = concepts
  .filter(c => c.data.updated || c.data.created)
  .sort((a, b) => {
    const aDate = a.data.updated || a.data.created;
    const bDate = b.data.updated || b.data.created;
    return bDate.localeCompare(aDate);
  })
  .slice(0, 15);

// === RSS ===
import rss from '@astrojs/rss';
export const GET = () => {
  const items = articles
    .filter(a => (a.data.sources || []).length > 0)
    .sort((a, b) => b.data.created.localeCompare(a.data.created))
    .slice(0, 40)
    .map(a => ({
      title: a.data.title,
      link: `/aied/articles/${a.id.replace('.md', '')}`,
      pubDate: new Date(a.data.created),
      description: a.body?.split('\n').slice(0, 5).join(' ')?.slice(0, 400) || '',
    }));
  return rss({
    title: 'AI Ed Wiki',
    description: 'AI in Education Research',
    site: 'https://edtechdev.github.io',
    items,
    stylesheet: '/aied/rss.xsl',
  } as any);
};
---

<BaseLayout title="Home" showNavToggle>
  <!-- === Three-column docs layout === -->
  <div class="docs-layout">

    <!-- Left: collapsible concept navigation (drawer on mobile) -->
    <button class="nav-backdrop" data-blume-nav-toggle type="button" aria-label="Close navigation"></button>
    <aside class="sidebar" data-blume-nav-drawer aria-label="Concept navigation">
      <div class="sidebar-heading">
        <a href="/aied/concepts/ai-education">AI in Education</a>
        <span class="sidebar-count">{indexedCount} concepts</span>
      </div>
      {conceptIndex.map((section, si) => (
        <details class="nav-section" open={si === 0}>
          <summary>{section.heading}</summary>
          <div class="nav-section-body">
            {section.groups.map(group => {
              const items = group.items.filter(slug => conceptMap[slug]);
              if (!items.length) return null;
              return (
                <div class="nav-group">
                  <div class="nav-group-label">{group.label}</div>
                  <ul class="nav-list">
                    {items.map(slug => (
                      <li><a href={`/aied/concepts/${slug}`}>{conceptMap[slug]}</a></li>
                    ))}
                  </ul>
                </div>
              );
            })}
          </div>
        </details>
      ))}
    </aside>

    <!-- Middle: introduction -->
    <main class="middle">
      <h1 class="page-title">AI in Education Research Wiki</h1>
      <p class="intro-paragraph">
        Welcome to the <strong>AI in Education Research Wiki</strong> — a living, machine-and-human-readable knowledge base of recent research on artificial intelligence in education. This site continuously <strong>ingests open-access research articles</strong> related to AI in education (from arXiv, EdArXiv, and peer-reviewed journals), summarizes each paper, and <strong>connects the articles through concept pages</strong> — shared concepts such as AI tutoring, assessment, AI literacy, equity, and feedback — so that related work is easy to discover. The site is <strong>generated by the Hermes AI agent</strong> and is updated regularly as new open-access research is published.
      </p>
      <p class="intro-paragraph">
        <strong>How to use this site:</strong> browse the hierarchical concept index in the left sidebar to explore themes, open any article page for a structured summary and its APA citation, or use the search box above. Because the full catalog and content are published as machine-readable files, you can also point your own AI assistant at this knowledge base — see <a href="/aied/ai" style="font-weight:500;">Use This Wiki with Your Own AI Assistant</a> for copy-paste prompts that let you explore AI in education research and educational AI applications with the wiki as your research reference.
      </p>
      <p class="intro-paragraph">
        <strong>AI in Education (AIED)</strong> is the broad, interdisciplinary field that applies artificial intelligence to teaching and learning, and studies its design, use, evaluation, and consequences. It spans <strong>AI for education</strong> — using AI to improve instruction, assessment, and administration — and <strong>education about AI</strong> — building the AI literacy and critical understanding learners and educators need. Start with the <a href="/aied/concepts/ai-education" style="font-weight:500;">AI in Education</a> overview page, then explore the concept strands in the sidebar.
      </p>

      <div class="middle-note">
        <strong>Browse by strand:</strong> each section in the left sidebar groups related concepts. Open a section, then click a concept for its overview, related articles, and connected concepts.
      </div>
    </main>

    <!-- Right: recent activity -->
    <aside class="right-col" aria-label="Recent activity">
      <section class="recent-block">
        <h2>📄 Recent Articles</h2>
        <ul class="recent-list">
          {recentArticles.map(a => (
            <li>
              <a href={`/aied/articles/${a.id.replace('.md', '')}`}>{a.data.title}</a>
              <span class="recent-date">{(a.data.created || '').split('T')[0]}</span>
            </li>
          ))}
        </ul>
        <p class="recent-more"><a href="/aied/journal">View all articles →</a></p>
      </section>

      <section class="recent-block">
        <h2>🏷️ Recently Updated Concepts</h2>
        <ul class="recent-list">
          {conceptsSorted.map(c => (
            <li>
              <a href={`/aied/concepts/${c.id.replace('.md', '')}`}>{c.data.title}</a>
              <span class="recent-date">{(c.data.updated || c.data.created || '').split('T')[0]}</span>
            </li>
          ))}
        </ul>
      </section>
    </aside>
  </div>
</BaseLayout>

<style>

  /* === Three-column docs layout === */
  .docs-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .docs-layout {
      grid-template-columns: 17rem minmax(0, 1fr);
    }
  }
  @media (min-width: 1280px) {
    .docs-layout {
      grid-template-columns: 17rem minmax(0, 1fr) 19rem;
    }
  }

  /* === Left sidebar / mobile drawer ===
     One element serves both: on mobile (<1024px) it is a fixed off-canvas drawer
     opened by the header hamburger (Blume-style); on desktop it is the static
     sticky sidebar. The `[data-blume-nav-open]` attribute lives on <html>. */
  .nav-backdrop {
    position: fixed;
    inset: 0;
    z-index: 30;
    display: none;
    background: rgba(0, 0, 0, 0.5);
    border: 0;
    cursor: pointer;
  }
  .sidebar {
    position: fixed;
    top: var(--drawer-top, 4rem);
    left: 0;
    z-index: 35;
    height: calc(100dvh - var(--drawer-top, 4rem));
    width: 17rem;
    max-width: 80vw;
    transform: translateX(-105%);
    transition: transform 0.25s ease;
    overflow-y: auto;
    background: var(--background-color);
    border-right: 1px solid var(--card-border-color);
    padding: 1rem 1.25rem 1.5rem 1rem;
  }
  /* The data-blume-nav-open attribute lives on <html>, so the attribute
     selector must be :global — otherwise Astro scoping would require the
     same element to carry both the scope id and the attribute, and the rule
     would never match the drawer. */
  :global([data-blume-nav-open]) .nav-backdrop { display: block; }
  :global([data-blume-nav-open]) .sidebar { transform: translateX(0); }
  @media (min-width: 1024px) {
    .nav-backdrop { display: none !important; }
    .sidebar {
      position: sticky;
      top: 1.25rem;
      height: auto;
      max-height: calc(100vh - 2.5rem);
      max-width: none;
      width: auto;
      transform: none;
      transition: none;
      z-index: auto;
      background: transparent;
      border-right: 1px solid var(--card-border-color);
      padding: 0 0.5rem 0 0;
    }
  }
  .sidebar-heading {
    margin-bottom: 0.75rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--card-border-color);
  }
  .sidebar-heading a {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color);
    text-decoration: none;
  }
  .sidebar-heading a:hover { color: var(--primary); }
  .sidebar-count {
    display: block;
    font-size: 0.78rem;
    color: var(--muted-color);
    margin-top: 0.2rem;
  }
  .nav-section {
    margin: 0 0 0.35rem 0;
    border: none;
    padding: 0;
  }
  .nav-section > summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color);
    padding: 0.4rem 0.25rem;
    border-radius: 6px;
    list-style-position: outside;
  }
  .nav-section > summary:hover { color: var(--primary); }
  .nav-section-body { padding: 0.1rem 0 0.5rem 0.6rem; }
  .nav-group { margin-bottom: 0.6rem; }
  .nav-group-label {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--muted-color);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }
  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--muted-border-color);
  }
  .nav-list li { margin: 0; }
  .nav-list a {
    display: block;
    font-size: 0.85rem;
    padding: 0.22rem 0.6rem;
    color: var(--muted-color);
    text-decoration: none;
    border-radius: 4px;
  }
  .nav-list a:hover {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 8%, transparent);
  }

  /* === Middle: introduction === */
  .middle {
    min-width: 0;
    max-width: 70rem;
  }
  .page-title {
    margin: 0 0 1.25rem 0;
    font-size: 1.6rem;
  }
  .intro-paragraph {
    color: var(--muted-color);
    margin-bottom: 1.25rem;
    font-size: 1.02rem;
    line-height: 1.7;
  }
  .middle-note {
    margin-top: 1.75rem;
    padding: 0.9rem 1.1rem;
    background: color-mix(in srgb, var(--primary) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--primary) 22%, transparent);
    border-left: 4px solid var(--primary);
    border-radius: 0 8px 8px 0;
    font-size: 0.92rem;
    color: var(--color);
  }

  /* === Right column: recent activity === */
  .right-col {
    padding-left: 0.5rem;
    border-left: 1px solid var(--card-border-color);
  }
  @media (min-width: 1024px) {
    .right-col {
      position: sticky;
      top: 1.25rem;
      max-height: calc(100vh - 2.5rem);
      overflow-y: auto;
    }
  }
  .recent-block {
    margin-bottom: 2rem;
  }
  .recent-block h2 {
    font-size: 1rem;
    margin: 0 0 0.6rem 0;
    color: var(--color);
  }
  .recent-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .recent-list li {
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--muted-border-color);
  }
  .recent-list li:last-child { border-bottom: none; }
  .recent-list a {
    display: block;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color);
    text-decoration: none;
    line-height: 1.4;
  }
  .recent-list a:hover { color: var(--primary); }
  .recent-date {
    display: block;
    font-size: 0.75rem;
    color: var(--muted-color);
    margin-top: 0.1rem;
  }
  .recent-more { margin: 0.6rem 0 0 0; }
  .recent-more a { font-size: 0.88rem; }
</style>
