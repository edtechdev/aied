---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = await getCollection('articles');
const concepts = await getCollection('concepts');
const faqs = await getCollection('faqs');

// All pages merged for journal view
const allItems = [
  ...articles.map(a => ({ ...a, kind: 'article' as const })),
  ...concepts.map(c => ({ ...c, kind: 'concept' as const })),
  ...faqs.map(f => ({ ...f, kind: 'faq' as const })),
];

const byDate: Record<string, typeof allItems> = {};
allItems.forEach(item => {
  const d = item.data.created.split('T')[0];
  (byDate[d] ||= []).push(item);
});
// Within each day, sort reverse-chronologically by created timestamp (string compare works because timestamps are full ISO)
Object.values(byDate).forEach(list => {
  list.sort((a, b) => (b.data.created || '').localeCompare(a.data.created || ''));
});
const dates = Object.keys(byDate).sort().reverse();
---

<BaseLayout title="Journal">
  <h1>📋 Journal</h1>
  <p>Reverse-chronological index of all {articles.length} articles, {concepts.length} concepts, and {faqs.length} FAQs in the knowledge base. <a href="/aied/rss.xml" style="color:var(--primary);font-weight:500;text-decoration:none;"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline-block;vertical-align:-0.15em;margin-right:0.2rem;"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>Subscribe to the RSS feed</a> for latest additions.</p>

  {dates.map(date => (
    <details class="journal-day" open={date === dates[0]} style="margin-bottom:0.75rem;border:1px solid var(--card-border-color);border-radius:8px;padding:0.75rem 1rem;">
      <summary style="cursor:pointer;font-weight:bold;color:var(--primary);font-size:1.05rem;">
        {date} — {byDate[date].length} page{byDate[date].length !== 1 ? 's' : ''}
      </summary>
      {byDate[date].map(item => {
        const base = item.kind === 'article' ? '/aied/articles' : item.kind === 'faq' ? '/aied/faqs' : '/aied/concepts';
        const href = `${base}/${item.id.replace('.md', '')}`;
        const icon = item.kind === 'article'
          ? '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline-block;vertical-align:-0.15em;margin-right:0.3rem;"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M16 13H8"></path><path d="M16 17H8"></path><path d="M10 9H8"></path></svg>'
          : item.kind === 'faq'
          ? '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline-block;vertical-align:-0.15em;margin-right:0.3rem;"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>'
          : '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline-block;vertical-align:-0.15em;margin-right:0.3rem;"><line x1="9" y1="18" x2="15" y2="18"></line><line x1="10" y1="22" x2="14" y2="22"></line><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5.76.76 1.23 1.52 1.41 2.5z"></path></svg>';
        return (
        <div class="journal-entry" style="padding:0.4rem 0 0.4rem 1.2rem;border-left:2px solid var(--primary);margin:0.3rem 0;">
          <a href={href} style="font-weight:500;" set:html={`<span>${icon}</span> ${item.data.title}`}></a>
        </div>
      )})}
    </details>
  ))}
</BaseLayout>