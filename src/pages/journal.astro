---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = await getCollection('articles');
const concepts = await getCollection('concepts');

// All pages merged for journal view
const allItems = [
  ...articles.map(a => ({ ...a, kind: 'article' as const })),
  ...concepts.map(c => ({ ...c, kind: 'concept' as const })),
];

const byDate: Record<string, typeof allItems> = {};
allItems.forEach(item => {
  const d = item.data.created.split('T')[0];
  (byDate[d] ||= []).push(item);
});
// Within each day, sort reverse-chronologically by created timestamp (string compare works because timestamps are full ISO)
Object.values(byDate).forEach(list => {
  list.sort((a, b) => (b.data.created || '').localeCompare(a.data.created || ''));
});
const dates = Object.keys(byDate).sort().reverse();
---

<BaseLayout title="Journal">
  <h1>📋 Journal</h1>
  <p>Reverse-chronological index of all {articles.length} articles and {concepts.length} concepts in the wiki.</p>

  {dates.map(date => (
    <details class="journal-day" open={date === dates[0]} style="margin-bottom:0.75rem;border:1px solid var(--card-border-color);border-radius:8px;padding:0.75rem 1rem;">
      <summary style="cursor:pointer;font-weight:bold;color:var(--primary);font-size:1.05rem;">
        {date} — {byDate[date].length} page{byDate[date].length !== 1 ? 's' : ''}
      </summary>
      {byDate[date].map(item => {
        const badge = item.kind === 'article' ? '📄' : '🏷️';
        const href = item.kind === 'article'
          ? `/aied/articles/${item.id.replace('.md', '')}`
          : `/aied/concepts/${item.id.replace('.md', '')}`;
        return (
        <div class="journal-entry" style="padding:0.4rem 0 0.4rem 1.2rem;border-left:2px solid var(--primary);margin:0.3rem 0;">
          <a href={href} style="font-weight:500;">
            <span style="font-size:0.8rem;">{badge}</span> {item.data.title}
          </a>
        </div>
      )})}
    </details>
  ))}
</BaseLayout>