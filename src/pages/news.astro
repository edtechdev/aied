---
// /aied/news — the archive of weekly newsletter issues.
//
// Newsletters are English-only (they live in content/en/newsletters and carry no
// translations), so unlike /journal this route has no [locale] twin. The listing
// copy below is therefore English by design; if the newsletter is ever translated,
// move it into src/i18n/pages/news.<locale>.ts the way the other pages are.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageTypeIcon from '../components/PageTypeIcon.astro';
import { rssIcon } from '../lib/pageTypeIcons';
import siteConfig from '../config/siteConfig';

const issues = (await getCollection('newsletters'))
  .filter(n => n.data.status !== 'draft')
  .sort((a, b) => b.data.created.localeCompare(a.data.created));

const formatDate = (iso: string): string => {
  const [y, m, d] = iso.split('T')[0].split('-').map(Number);
  return new Date(y, m - 1, d).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

const base = siteConfig.basePath;
const newsletterFeed = `${base}/news/rss.xml`;
const siteFeed = `${base}/rss.xml`;
---

<BaseLayout title="AIEd KB Weekly Update" description="The weekly newsletter of the AI in Education Knowledge Base: what new research means for instructors, developers, researchers, and administrators.">
  <h1><PageTypeIcon kind="newsletter" size={32} />AIEd KB Weekly Update</h1>

  <p class="news-intro">
    A weekly brief from the <a href={`${base}/`}>AI in Education Knowledge Base</a>, on what new{' '}
    research published in the week means for instructors, developers, researchers, and administrators.
    Every issue links the paper behind every claim, and the internal work at the bottom tracks what
    changed on the site itself.
  </p>

  <p class="news-intro">
    Two RSS feeds carry it. The <a href={newsletterFeed}><Fragment set:html={rssIcon(14)} />newsletter feed</a>{' '}
    holds the issues only, one entry a week. The{' '}
    <a href={siteFeed}><Fragment set:html={rssIcon(14)} />knowledge base feed</a>{' '}
    holds every new article summary as it is added, which is the same material the issues are drawn
    from, at a much higher rate.
  </p>

  {issues.length === 0 ? (
    <p class="news-empty">No issues have been published yet.</p>
  ) : (
    <div class="news-list">
      {issues.map(issue => (
        <div class="news-entry">
          <a href={`${base}/news/${issue.id.replace('.md', '')}/`} class="news-issue">
            <span class="news-issue-head">
              <span class="news-issue-title"><PageTypeIcon kind="newsletter" size={16} />{issue.data.title}</span>
              <span class="news-issue-date">{formatDate(issue.data.created)}</span>
            </span>
            <span class="news-issue-summary" set:html={issue.data.summary} />
          </a>
        </div>
      ))}
    </div>
  )}

  <style>
    .news-intro {
      line-height: 1.7;
      margin-bottom: 1rem;
      max-width: 46rem;
    }
    .news-empty {
      color: var(--muted-color);
    }
    .news-list {
      margin: 1.75rem 0 0;
    }
    /* An issue reads like a journal entry: a line with the accent bar on the left,
       not a boxed card. The summary is the only thing a journal row does not have,
       so it sits under the title in muted text. */
    .news-entry {
      border-inline-start: 2px solid var(--primary);
      margin: 0.3rem 0;
      padding-block: 0.4rem;
      padding-inline: 1.2rem 0;
    }
    .news-issue {
      display: block;
      text-decoration: none;
      color: inherit;
    }
    .news-issue:hover .news-issue-title,
    .news-issue:focus-visible .news-issue-title {
      text-decoration: underline;
    }
    .news-issue-head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.6rem;
    }
    .news-issue-title {
      font-weight: 600;
      color: var(--primary);
    }
    .news-issue-date {
      color: var(--muted-color);
      font-size: 0.9rem;
    }
    .news-issue-summary {
      display: block;
      margin-top: 0.2rem;
      line-height: 1.55;
      color: var(--muted-color);
      font-size: 0.95rem;
    }
  </style>
</BaseLayout>
