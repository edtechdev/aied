---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceButtons from '../../components/SourceButtons.astro';
import JsonLd from '../../components/JsonLd.astro';
import MetadataTable from '../../components/MetadataTable.astro';
import StarButton from '../../components/StarButton.astro';
import { renderMarkdown, smartTitle } from '../../lib/markdown';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(a => ({ params: { slug: a.id.replace('.md', '') } }));
}

const { slug } = Astro.params;
const articles = await getCollection('articles');


const concepts = await getCollection('concepts');
const conceptTitles: Record<string, string> = Object.fromEntries(
  concepts.map((c) => [c.id.replace('.md', ''), c.data.title]),
);
const faqs = await getCollection('faqs');

// Tag chips use the page's own title ("Well-Being", not "well being"); long titles
// are skipped so a chip stays short.
const tagLabel = (tag: string): string => {
  const t = allTitles[tag];
  return t && t.length <= 28 ? t : smartTitle(tag.replace(/-/g, ' '));
};

const article = articles.find(a => a.id.replace('.md', '') === slug);
if (!article) return Astro.redirect('/aied/');

// For canonical wikilink routing: map slug -> canonical base path
const articleSlugs = new Set(articles.map(a => a.id.replace('.md', '')));
const conceptSlugs = new Set(concepts.map(c => c.id.replace('.md', '')));
const faqSlugs = new Set(faqs.map(f => f.id.replace('.md', '')));
const faqById = new Map(faqs.map(f => [f.id.replace('.md', ''), f]));

// Connected FAQs: slugs in frontmatter `connected_faqs`
const connectedFaqs = (article.data.connected_faqs || [])
  .map(s => faqById.get(s))
  .filter((f): f is NonNullable<typeof f> => Boolean(f));

const { title, created, updated, research_method, discipline, audience, level, page_kind, foundations, pedagogy, technology, assessment, methods, stakeholders, systems, ethics } = article.data;
// JSON-LD keywords: the typed fields, which replaced the old per-page tag list.
const metadataKeywords: string[] = [...(research_method || []), ...(discipline || []), ...(level || []), ...(audience || []), ...(foundations || []), ...(pedagogy || []), ...(technology || []), ...(assessment || []), ...(stakeholders || []), ...(ethics || []), ...(page_kind || []), ...(methods || []), ...(systems || []),];
// Build PageFind filter facets from the structured metadata fields.
// Each metadata field becomes a facet group. We emit one <meta> element per
// `name:value` pair (PageFind requires each inline filter to be its own
// element — comma-joining multiple inline `name:value` filters only parses the
// LAST one, so page_type + all facets must be separate elements).
const metaFields: { name: string; values: string[] | undefined }[] = [
  { name: 'foundations', values: foundations },
  { name: 'pedagogy', values: pedagogy },
  { name: 'technology', values: technology },
  { name: 'assessment', values: assessment },
  { name: 'methods', values: methods },
  { name: 'systems', values: systems },
  { name: 'stakeholders', values: stakeholders },
  { name: 'ethics', values: ethics },
  { name: 'level', values: level },
  { name: 'audience', values: audience },
  { name: 'discipline', values: discipline },
  { name: 'page_kind', values: page_kind },
  { name: 'research_method', values: research_method },
];
const pagefindFilterPairs: string[] = metaFields
  .flatMap(({ name, values }) => (values || []).map((v) => `${name}:${v}`));
const createdDisplay = (created || '').split('T')[0];
const updatedDisplay = (updated || created || '').split('T')[0];
const body = article.body || '';

// Connected concept slugs for JSON-LD about/mentions (from body Connected Concepts section)
const connectedConceptSlugs = (body.match(/^## Connected Concepts\s*\n([\s\S]*?)(?=^## |\Z)/m)?.[1] || '')
  .split('\n')
  .map(l => l.match(/\[\[([^\]|]+)/)?.[1])
  .filter(Boolean);


// slug -> display title for every page: wikilink labels and tag chips use the page's
// own title ('Well-Being'), not a de-slugified guess ('well being').
const allTitles: Record<string, string> = {};
[...concepts, ...articles, ...faqs].forEach(c => { allTitles[c.id.replace('.md', '')] = c.data.title; });

const rendered = renderMarkdown(body, { pageTitle: title, articleSlugs, conceptSlugs, faqSlugs, titles: allTitles });
const toc = rendered.headings.filter(h => h.depth <= 3);
if (connectedFaqs.length > 0) {
  toc.push({ text: 'Connected FAQs', slug: 'connected-faqs', depth: 2 });
}
---
<BaseLayout title={title} toc={toc}>
  <JsonLd
    type="article"
    slug={slug}
    title={title}
    created={created}
    updated={updated}
    keywords={metadataKeywords}
    body={body}
    sources={article.data.sources}
    connectedConceptSlugs={connectedConceptSlugs}
    connectedFaqSlugs={connectedFaqs.map((f: any) => f.id.replace('.md', ''))}
  />
  <article data-pagefind-filter="page_type:article">
    {pagefindFilterPairs.map((pair) => <meta data-pagefind-filter={pair} />)}
    <div class="page-header" id="top">
      <p class="page-type-badge" style="font-size:0.8rem;color:var(--muted-color);margin-bottom:0.25rem;"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:inline-block;vertical-align:-0.15em;margin-right:0.3rem;"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path><path d="M16 13H8"></path><path d="M16 17H8"></path><path d="M10 9H8"></path></svg>Research Article</p>
      <h1>{title}</h1>
      <div class="page-meta" style="color:var(--muted-color);font-size:0.9rem;margin-bottom:0.75rem;">
        <StarButton slug={slug} kind="article" />
        created {createdDisplay}{updated ? ` · updated ${updatedDisplay}` : ''}
      </div>
    </div>

    <div style="line-height:1.8" data-pagefind-body>
      <Fragment set:html={rendered.html} />
    </div>

    {connectedFaqs.length > 0 && (
      <section style="margin-top:2.5rem;" id="connected-faqs">
        <h2 style="border-bottom:2px solid var(--primary);padding-bottom:0.5rem;">Connected FAQs</h2>
        <ul style="list-style:none;padding:0;margin:0.5rem 0 0 0;">
          {connectedFaqs.map(f => (
            <li style="padding:0.5rem 0;border-bottom:1px solid var(--card-border-color);">
              <a href={`/aied/faqs/${f.id.replace('.md', '')}/`} style="font-weight:500;color:var(--primary);text-decoration:none;">
                ❓ {f.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <MetadataTable conceptTitles={conceptTitles} data={article.data} />
    <SourceButtons filePath={`articles/${article.id}.md`} />
  </article>
</BaseLayout>
