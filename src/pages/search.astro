---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search">
  <h1>🔍 Search</h1>
  <p style="color:var(--muted-color);margin-bottom:1.5rem;">
    Search across articles and concepts. Use the <strong>Type</strong> filter to narrow results.
  </p>

  <div class="search-interface">
    <pagefind-config bundle-path="/aied/pagefind/"></pagefind-config>
    <div class="search-controls">
      <pagefind-input placeholder="Search articles and concepts..."></pagefind-input>
      <pagefind-filter-dropdown filter="page_type" label="Type" sort="alphabetical"></pagefind-filter-dropdown>
    </div>
    <pagefind-summary></pagefind-summary>
    <pagefind-results show-excerpt></pagefind-results>
  </div>
</BaseLayout>

<link href="/aied/pagefind/pagefind-component-ui.css" rel="stylesheet" />

<style>
  .search-interface {
    max-width: 800px;
    margin: 0 auto;
  }
  .search-controls {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    align-items: flex-start;
    flex-wrap: wrap;
  }
  .search-controls pagefind-input {
    flex: 1;
    min-width: 250px;
  }
  .search-controls pagefind-filter-dropdown {
    flex-shrink: 0;
  }

  pagefind-input::part(input) {
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: 1.05rem;
    border: 2px solid var(--card-border-color);
    border-radius: 6px;
    background: var(--card-background-color);
  }
  pagefind-input::part(input):focus {
    border-color: var(--primary);
    outline: none;
  }

  pagefind-filter-dropdown::part(trigger) {
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    border: 2px solid var(--card-border-color);
    border-radius: 6px;
    background: var(--card-background-color);
    cursor: pointer;
    white-space: nowrap;
  }
  pagefind-filter-dropdown::part(trigger):hover {
    border-color: var(--primary);
  }

  pagefind-summary::part(summary) {
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
    color: var(--muted-color);
  }

  pagefind-results::part(result) {
    padding: 1rem 0;
    border-bottom: 1px solid var(--card-border-color);
  }
  pagefind-results::part(result-title) {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--primary);
    text-decoration: none;
  }
  pagefind-results::part(result-title):hover {
    text-decoration: underline;
  }
  pagefind-results::part(result-excerpt) {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--muted-color);
    margin-top: 0.25rem;
  }
  pagefind-results::part(result-filters) {
    margin-top: 0.5rem;
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
  }
</style>

<script is:inline>
  import("/aied/pagefind/pagefind-component-ui.js");
  // Read ?q= from the URL and pre-fill the search input + trigger the search.
  (() => {
    const q = new URLSearchParams(window.location.search).get("q");
    const run = () => {
      const host = document.querySelector("pagefind-input");
      if (!host) return false;
      const input = host.querySelector("input");
      if (!input) return false;
      if (q) {
        input.value = q;
        input.dispatchEvent(new Event("input", { bubbles: true }));
        input.focus();
      }
      return true;
    };
    if (!run()) {
      const start = Date.now();
      const timer = setInterval(() => {
        if (run() || Date.now() - start > 4000) clearInterval(timer);
      }, 150);
    }
  })();
</script>