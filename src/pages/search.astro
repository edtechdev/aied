---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" hideHeaderSearch>
  <h1>🔍 Search</h1>
  <p style="color:var(--muted-color);margin-bottom:1.5rem;">
    Search across articles and concepts. Use the <strong>Type</strong> filter to narrow results.
  </p>

  <div class="search-interface">
    <pagefind-config bundle-path="/aied/pagefind/" faceted></pagefind-config>
    <div class="search-controls">
      <pagefind-input placeholder="Search articles, concepts, and FAQs..."></pagefind-input>
    </div>
    <div class="filter-bar">
      <pagefind-filter-dropdown filter="page_type" label="Type"></pagefind-filter-dropdown>
      <pagefind-filter-dropdown filter="discipline" label="Discipline"></pagefind-filter-dropdown>
      <pagefind-filter-dropdown filter="level" label="Level"></pagefind-filter-dropdown>
      <pagefind-filter-dropdown filter="audience" label="Audience"></pagefind-filter-dropdown>
      <pagefind-filter-dropdown filter="category" label="Category"></pagefind-filter-dropdown>
      <pagefind-filter-dropdown filter="research_method" label="Research Method"></pagefind-filter-dropdown>
    </div>
    <pagefind-summary></pagefind-summary>
    <pagefind-results show-excerpt></pagefind-results>
  </div>
</BaseLayout>

<link href="/aied/pagefind/pagefind-component-ui.css" rel="stylesheet" />

<style>
  .search-interface {
    max-width: 800px;
    margin: 0 auto;
  }
  .search-controls {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    align-items: flex-start;
    flex-wrap: wrap;
  }
  .search-controls pagefind-input {
    flex: 1;
    min-width: 250px;
  }
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }
  pagefind-filter-dropdown {
    flex: 0 0 auto;
  }
  pagefind-filter-dropdown::part(trigger) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    font-size: 0.9rem;
    border: 2px solid var(--card-border-color);
    border-radius: 6px;
    background: var(--card-background-color);
    color: var(--color);
    cursor: pointer;
    white-space: nowrap;
  }
  pagefind-filter-dropdown::part(trigger):hover {
    border-color: var(--primary);
  }
  pagefind-filter-dropdown::part(menu) {
    background: var(--card-background-color);
    border: 2px solid var(--card-border-color);
    border-radius: 6px;
  }
  pagefind-filter-dropdown::part(option) {
    font-size: 0.9rem;
    color: var(--color);
  }
  pagefind-filter-dropdown::part(option):hover {
    background: color-mix(in srgb, var(--primary) 10%, transparent);
  }

  pagefind-input::part(input) {
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: 1.05rem;
    border: 2px solid var(--card-border-color);
    border-radius: 6px;
    background: var(--card-background-color);
  }
  pagefind-input::part(input):focus {
    border-color: var(--primary);
    outline: none;
  }

  pagefind-summary::part(summary) {
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
    color: var(--muted-color);
  }

  pagefind-results::part(result) {
    padding: 1rem 0;
    border-bottom: 1px solid var(--card-border-color);
  }
  pagefind-results::part(result-title) {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--primary);
    text-decoration: none;
  }
  pagefind-results::part(result-title):hover {
    text-decoration: underline;
  }
  pagefind-results::part(result-excerpt) {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--muted-color);
    margin-top: 0.25rem;
  }
  pagefind-results::part(result-filters) {
    margin-top: 0.5rem;
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
  }
</style>

<script is:inline>
  // Sync the search term AND selected filters to the URL so searches can be
  // bookmarked and shared. Uses ?q=<term>&f=<base64 JSON of filters>.
  // Runs on an interval (independent of the PageFind module load timing) so it
  // reliably attaches once the components are registered.
  (function () {
    const readParams = () => {
      const p = new URLSearchParams(window.location.search);
      let filters = {};
      try {
        const f = p.get("f");
        if (f) filters = JSON.parse(atob(f));
      } catch {}
      return { q: p.get("q") || "", filters };
    };

    const writeParams = (q, filters) => {
      const p = new URLSearchParams();
      if (q) p.set("q", q);
      const hasFilters = Object.keys(filters || {}).some((k) => (filters[k] || []).length);
      if (hasFilters) p.set("f", btoa(JSON.stringify(filters)));
      const qs = p.toString();
      const url = qs ? window.location.pathname + "?" + qs : window.location.pathname;
      window.history.replaceState({}, "", url);
    };

    const { q, filters } = readParams();
    let attached = false;
    let retry = 0;

    const attempt = () => {
      const C = window.PagefindComponents;
      if (!C || !C.getInstanceManager) { setTimeout(attempt, 200); return; }
      let inst;
      try { inst = C.getInstanceManager().getInstance("default"); } catch { inst = null; }
      if (!inst) { setTimeout(attempt, 200); return; }

      // Persist on every search — but never write an empty state.
      if (!attached) {
        attached = true;
        inst.on("search", (term, f) => {
          const ff = f || {};
          const hasFilters = Object.keys(ff).some((k) => (ff[k] || []).length);
          if (!term && !hasFilters) return;
          writeParams(term, ff);
        });
      }

      // Restore the query by calling triggerSearchWithFilters once — this sets
      // the input value AND runs the search atomically. Manually dispatching
      // input events instead causes PageFind to re-render and clear the input.
      if (q || Object.keys(filters).length) {
        try { inst.triggerSearchWithFilters(q, filters); } catch {}
      }
    };
    setTimeout(attempt, 300);
  })();
</script>