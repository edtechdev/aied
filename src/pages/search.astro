---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search">
  <h1>🔍 Search</h1>
  <div class="search-bar">
    <input type="text" id="search-input" placeholder="Search by title, tag, or content..." autocomplete="off" />
  </div>
  <div id="search-results">
    <p style="color:var(--muted-color)">Loading search index...</p>
  </div>
</BaseLayout>

<script>
  let pages: any[] = [];
  let ready = false;
  
  fetch('/aied/search-index.json')
    .then(r => r.json())
    .then(data => { 
      pages = data;
      ready = true;
      document.getElementById('search-results')!.innerHTML = 
        '<p style="color:var(--muted-color)">Type to search across ' + pages.length + ' articles...</p>';
      // Process any pending query from URL
      const params = new URLSearchParams(window.location.search);
      const q = params.get('q');
      if (q) {
        (document.getElementById('search-input') as HTMLInputElement).value = q;
        doSearch(q);
      }
    })
    .catch(() => {
      document.getElementById('search-results')!.innerHTML = 
        '<p style="color:red">Failed to load search index. Please try again.</p>';
    });

  function doSearch(q: string) {
    if (!ready || !q) return;
    const results = document.getElementById('search-results')!;
    const matches = pages.filter((p: any) => {
      const text = `${p.title} ${p.tags?.join(' ')} ${p.body || ''}`.toLowerCase();
      return text.includes(q.toLowerCase());
    }).slice(0, 30);

    if (matches.length === 0) {
      results.innerHTML = '<p>No results found for "<strong>' + q + '</strong>". Try a different search term.</p>';
      return;
    }

    results.innerHTML = '<p style="color:var(--muted-color)">' + matches.length + ' result' + (matches.length !== 1 ? 's' : '') + ' for "<strong>' + q + '</strong>"</p>' +
      matches.map((p: any) => `
      <div class="page-item">
        <a href="/aied/pages/${p.slug}" style="font-weight:500;">${p.title}</a>
        <div style="font-size:0.8rem;color:var(--muted-color);">
          ${p.created || ''} · ${(p.tags || []).slice(0, 5).map((t: string) => 
            `<a href="/aied/tags/${t}" class="tag-chip" style="font-size:0.68rem;padding:0.03rem 0.35rem;">${t}</a>`
          ).join('')}
        </div>
      </div>
    `).join('');
  }

  document.getElementById('search-input')!.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value.trim();
    doSearch(q);
  });
</script>