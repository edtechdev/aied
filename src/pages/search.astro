---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" hideHeaderSearch>
  <h1>🔍 Search</h1>
  <p style="color:var(--muted-color);margin-bottom:1.5rem;">
    Search across articles and concepts. Use the <strong>Type</strong> filter to narrow results.
  </p>

  <div class="search-interface">
    <pagefind-config bundle-path="/aied/pagefind/"></pagefind-config>
    <div class="search-controls">
      <pagefind-input placeholder="Search articles, concepts, and FAQs..."></pagefind-input>
      <pagefind-filter-pane expanded></pagefind-filter-pane>
    </div>
    <pagefind-summary></pagefind-summary>
    <pagefind-results show-excerpt></pagefind-results>
  </div>
</BaseLayout>

<link href="/aied/pagefind/pagefind-component-ui.css" rel="stylesheet" />

<style>
  .search-interface {
    max-width: 800px;
    margin: 0 auto;
  }
  .search-controls {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    align-items: flex-start;
    flex-wrap: wrap;
  }
  .search-controls pagefind-input {
    flex: 1;
    min-width: 250px;
  }
  pagefind-filter-pane {
    flex-shrink: 0;
    width: 100%;
  }
  /* The filter pane renders its checkboxes in the light DOM with plain
     classes (no shadow parts), so target them globally. */
  :global(.pf-filter-pane) {
    background: var(--card-background-color);
    border: 2px solid var(--card-border-color);
    border-radius: 6px;
    padding: 0.75rem 1rem;
    margin-top: 0.25rem;
  }
  :global(.pf-filter-group) {
    margin-top: 0.6rem;
  }
  :global(.pf-filter-group-title) {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted-color);
    margin: 0 0 0.25rem 0;
  }
  :global(.pf-filter-options) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
  }
  :global(.pf-filter-checkbox) {
    font-size: 0.9rem;
    color: var(--color);
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  pagefind-input::part(input) {
    width: 100%;
    padding: 0.75rem 1rem;
    font-size: 1.05rem;
    border: 2px solid var(--card-border-color);
    border-radius: 6px;
    background: var(--card-background-color);
  }
  pagefind-input::part(input):focus {
    border-color: var(--primary);
    outline: none;
  }

  pagefind-summary::part(summary) {
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
    color: var(--muted-color);
  }

  pagefind-results::part(result) {
    padding: 1rem 0;
    border-bottom: 1px solid var(--card-border-color);
  }
  pagefind-results::part(result-title) {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--primary);
    text-decoration: none;
  }
  pagefind-results::part(result-title):hover {
    text-decoration: underline;
  }
  pagefind-results::part(result-excerpt) {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--muted-color);
    margin-top: 0.25rem;
  }
  pagefind-results::part(result-filters) {
    margin-top: 0.5rem;
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
  }
</style>

<script is:inline>
  import("/aied/pagefind/pagefind-component-ui.js");
</script>