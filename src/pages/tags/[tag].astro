---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  const concepts = await getCollection('concepts');
  const tagSet = new Set<string>();
  articles.forEach(a => (a.data.tags || []).forEach(t => tagSet.add(t)));
  concepts.forEach(c => (c.data.tags || []).forEach(t => tagSet.add(t)));
  return [...tagSet].map(tag => ({ params: { tag } }));
}

const { tag } = Astro.params;
const articles = await getCollection('articles');
const concepts = await getCollection('concepts');

const taggedArticles = articles.filter(a => (a.data.tags || []).includes(tag!));
const taggedConcepts = concepts.filter(c => (c.data.tags || []).includes(tag!));

const allPages = [
  ...taggedArticles.map(a => ({ ...a, kind: 'article' as const })),
  ...taggedConcepts.map(c => ({ ...c, kind: 'concept' as const })),
].sort((a, b) => b.data.created.localeCompare(a.data.created));

// Find co-occurring tags
const coTags: Record<string, number> = {};
allPages.forEach(p => {
  (p.data.tags || []).forEach(t => {
    if (t !== tag) coTags[t] = (coTags[t] || 0) + 1;
  });
});
const related = Object.entries(coTags).sort((a, b) => b[1] - a[1]).slice(0, 15);
---

<BaseLayout title={`Tag: ${tag}`}>
  <h1>🏷️ <Fragment set:html={`${tag}`} /></h1>
  <p>{allPages.length} page{allPages.length !== 1 ? 's' : ''} tagged with <strong>{tag}</strong>
    ({taggedArticles.length} articles, {taggedConcepts.length} concepts)
  </p>

  <div style="margin:1.5rem 0;">
    {allPages.map(p => {
      const href = p.kind === 'article'
        ? `/aied/articles/${p.id.replace('.md', '')}`
        : `/aied/concepts/${p.id.replace('.md', '')}`;
      const badge = p.kind === 'article' ? '📄' : '🏷️';
      const summary = ((p.body || '')
        .split('\n')
        .filter(l => l.startsWith('>'))
        .join(' ')
        .slice(0, 200))
        || (p.body || '').split('\n').filter(l => l.trim() && !l.startsWith('#') && !l.startsWith('>') && !l.startsWith('|') && !l.startsWith('-')).slice(0, 2).join(' ').slice(0, 200);
      return (
      <div class="page-item">
        <a href={href} style="font-weight:500;">
          <span style="font-size:0.8rem;">{badge}</span> {p.data.title}
        </a>
        {summary && <div style="font-size:0.82rem;color:var(--muted-color);margin-top:0.15rem;line-height:1.4;">{summary}…</div>}
        <div style="font-size:0.8rem;color:var(--muted-color);">
          {p.data.created} · {(p.data.tags || []).filter(t => t !== tag).slice(0, 5).map((t, i) => (
            <>{i > 0 ? ', ' : ''}<a href={`/aied/tags/${t}`} class="tag-chip" style="font-size:0.7rem;padding:0.03rem 0.35rem;">{t}</a></>
          ))}
        </div>
      </div>
    )})}
  </div>

  {related.length > 0 && (
    <div style="margin-top:2rem;padding:1rem;background:var(--card-background-color);border-radius:8px;">
      <h3>Related Tags</h3>
      {related.map(([t, n]) => (
        <a href={`/aied/tags/${t}`} class="tag-chip">{t} ({n})</a>
      ))}
    </div>
  )}
</BaseLayout>